---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.astro';
import PostImage from '../components/PostImage.astro';
import PriceCards from '../components/PriceCards.astro';
import Clock from '../components/Clock.astro';
import ServiceArt from '../components/ServiceArt.astro';
import photo from '../assets/sakib-islam.jpg';
import appShot from '../assets/work/extra/wrkbase-1.jpg';
import { site } from '../site.js';
import { services } from '../services.js';
import { work } from '../work.js';
import { reviews, initials, allReviewsUrl } from '../reviews.js';
import { clients, clientCount } from '../clients.js';
import { posts } from '../blog.js';
import { prices, usd, typical } from '../prices.js';
import { icps } from '../icps.js';
import { toolLogos } from '../toolLogos.js';

// Focus keyword for this page. It must appear in the title, the description and the H1 (scripts/seo-check.mjs).
const focus = 'Full stack web developer';
const title = 'Full Stack Web Developer for Businesses | Sakib Islam';
const description =
  'Full stack web developer for custom websites and web apps: UI/UX, frontend and backend. Get a quote.';

const shot = (slug) => work.find((w) => w.slug === slug);
const tabby = shot('tabby');
// Selected work: the first is shown large. Wrkbase is shown by its app screen, the rest by their home pages.
const mosaic = ['mayabee', 'tabby', 'wrkbase', 'moneybag', 'open-alliance-learning'].map(shot).map((w) => ({ ...w, img: w.slug === 'wrkbase' ? appShot : w.shot }));

// Trust numbers. Each can be checked: the client list is in src/clients.js (Sakib's own list of sites built or fixed),
// full-time WordPress work starts at Oxford International School in Feb 2023, and the two results are from the
// TubeOnAI and Tabby case studies.
// The logo row shows only the best-known clients; the full list stays in src/clients.js.
const featured = ['Mayabee', 'Tabby', 'TubeOnAI', 'Moneybag', 'Wrkbase', 'Oxford International School'];
const logos = featured.map((n) => clients.find((c) => c.name === n)).filter(Boolean);
const trust = [
  { n: `${clientCount}+`, label: 'client websites built or fixed' },
  { n: '3+', label: 'years building websites full-time' },
  { n: '70%', label: 'faster page loads for TubeOnAI, 5 s down to 1.5 s' },
  { n: '90+', label: 'Core Web Vitals at launch for Tabby' },
];
const experience = [
  { yr: '2026 →', role: 'IT Executive', org: 'Open Academy London, online education', kind: 'Full-time' },
  { yr: '2026 →', role: 'Founder', org: 'Wrkbase, team management SaaS', kind: 'Own product' },
  { yr: '2026', role: 'Full-stack developer', org: 'Mayabee, online shop with its own dashboard', kind: 'Project' },
  { yr: '2025 →', role: 'WordPress developer', org: 'Tabby, AI bookkeeping (US)', kind: 'Freelance' },
  { yr: '2025', role: 'Payment gateway plugin', org: 'Moneybag, fintech', kind: 'Project' },
  { yr: '2024', role: 'WordPress developer', org: 'TubeOnAI, AI summaries', kind: 'Part-time' },
  { yr: '2023', role: 'WordPress developer', org: 'Oxford International School, Dhaka', kind: 'Full-time' },
];
const plans = [
  { name: 'Custom website', for: 'A business website or online store built from scratch.', price: usd(prices.site), unit: ' from', billing: `Typically ${typical.site}`, items: ['Competitor research and UI/UX design', 'Frontend, backend and admin dashboard', 'Core Web Vitals checked on a phone'], cta: 'Start a website', href: '/contact/?need=build', featured: true, badge: 'Most projects' },
  { name: 'Web application', for: 'A portal, internal tool or SaaS first version.', price: usd(prices.webApp), unit: ' from', billing: `Typically ${typical.webApp}`, items: ['Accounts, roles and a dashboard', 'API and integrations', 'A first version users can start on'], cta: 'Get a free quote', href: '/contact/?need=webapp' },
  { name: 'WordPress build', for: 'A custom WordPress theme, plugin or WooCommerce store.', price: usd(prices.build), unit: ' from', billing: `Typically ${typical.wordpress}`, items: ['Custom theme from your design', 'Custom plugins and payments', 'Built to load fast and survive updates'], cta: 'Start a build', href: '/contact/?need=build' },
  { name: 'Website care', for: 'Keep a working website safe and current.', price: usd(prices.care), unit: '/mo', billing: 'Cancel any month', items: ['Updates tested before they go live', 'Daily off-site backups', 'Urgent reply within 24 hours'], cta: 'Start a plan', href: '/contact/?plan=care' },
];

const toolGroups = [
  { name: 'AI assistants', note: 'I use AI to speed up routine work. I read and test everything that ships.', items: [['Claude', 'writing and reviewing code, drafting copy', 'claude'], ['ChatGPT', 'research and second opinions', 'chatgpt'], ['Gemini', 'research and long documents', 'gemini']] },
  { name: 'Code and build', items: [['VS Code', 'my code editor', 'vscode'], ['Git and GitHub', 'version control', 'github'], ['Astro', 'fast static websites', 'astro'], ['WordPress and WooCommerce', 'themes, plugins and stores', 'wordpress'], ['PHP and MySQL', 'backends and APIs', 'php']] },
  { name: 'Design', items: [['Figma', 'designs and developer handoff', 'figma'], ['Claude Design', 'UI mockups and brand images', 'claude']] },
  { name: 'Test and measure', items: [['Chrome DevTools', 'debugging and mobile testing', 'chrome'], ['Google PageSpeed Insights', 'Core Web Vitals scores', 'pagespeed'], ['Google Search Console', 'search performance', 'searchconsole'], ['Semrush', 'keyword research', 'semrush']] },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: 'Full Stack Web Developer',
    email: site.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
    url: Astro.site,
    image: { '@type': 'ImageObject', url: new URL(photo.src, Astro.site), width: photo.width, height: photo.height, caption: 'Sakib Islam, full stack web developer' },
    telephone: site.phone,
    sameAs: [site.linkedin, site.wrkbase, site.github, site.facebook].filter(Boolean),
    knowsAbout: ['Full stack web development', 'Custom website development', 'Web application development', 'WordPress theme and plugin development', 'Website maintenance', 'Core Web Vitals', 'WooCommerce', 'White-label WordPress development', 'SaaS development'],
    makesOffer: [
      ...services.map((sv) => ({ slug: sv.slug, name: sv.name })),
      { slug: 'website-care', name: 'Website care' },
      { slug: 'white-label-wordpress-development', name: 'White-label WordPress development' },
    ].map((sv) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.name, url: new URL(`/${sv.slug}/`, Astro.site) } })),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: Astro.site },
];
const svc = [
  { slug: 'custom-web-development', name: 'Custom website development', what: 'A business website or online store built from scratch for your business, with the admin dashboard your team uses.', gets: ['Competitor research and UI/UX design', 'Frontend and backend development', 'Admin dashboard, accounts and payments'], price: `Websites from ${usd(prices.site)}, stores from ${usd(prices.store)}`, proof: 'Example: Mayabee, an online shop with its own dashboard', href: '/custom-web-development/' },
  { slug: 'web-application-development', name: 'Web application development', what: 'Software your customers or staff sign in to: a portal, an internal tool, a booking system or a SaaS product.', gets: ['Accounts, roles and permissions', 'Dashboards, reports and APIs', 'AI features that ask before they act'], price: `First versions from ${usd(prices.webApp)}`, proof: 'Example: Wrkbase, my own team platform with an AI agent', href: '/web-application-development/' },
  { slug: 'wordpress-development', name: 'WordPress development', what: 'Custom WordPress themes and plugins, WooCommerce stores and integrations, built to your design.', gets: ['Custom themes from your Figma design', 'Custom plugins and payment gateways', 'WooCommerce stores and integrations'], price: `Themes from ${usd(prices.build)}, stores from ${usd(prices.woo)}`, proof: 'Example: a payment gateway plugin for Moneybag', href: '/wordpress-development/' },
  { slug: 'website-care', name: 'Website care', what: 'Monthly care for a live website: updates, backups, monitoring, fixes and speed, handled by the developer who knows your site.', gets: ['Tested updates and daily off-site backups', 'Security and uptime monitoring', 'Bug fixes, speed and small changes'], price: `From ${usd(prices.care)} a month`, proof: 'Example: Tabby, built and maintained by me', href: '/website-care/' },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus}>
  <section class="h-hero wrap hero-bg">
    <canvas class="dots dots-bleed" aria-hidden="true"></canvas>
    <div class="h-grid">
      <div class="h-copy">
        <p class="eyebrow">Full stack web developer · Dhaka, working remotely</p>
        <h1><span class="ln">Full stack web developer</span> <span class="ln">for custom websites</span> <span class="ln">and web apps.</span></h1>
        <p class="lead">I'm Sakib, a full stack web developer. I start with competitor analysis to find the gaps, design the UI and UX myself, then build everything from frontend to backend. Send me your website URL or project requirements and I'll review your needs and give you clear pricing.</p>
        <div class="btn-row">
          <a class="btn" href="/contact/">Get a free quote</a>
          <a class="btn btn-ghost" href="/#work">See my work</a>
        </div>
        <p class="mono mut h-meta"><Clock compact /> <span>Overlaps US and UK hours</span> <span>Reply within 24 hours</span></p>
      </div>
      <div class="h-collage" aria-label="Sites I built">
        <div class="browser c-back">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>mayabeebd.com</span></div>
          <Picture src={shot('mayabee').shot} formats={['avif', 'webp']} widths={[560, 860]} sizes="(max-width: 900px) 78vw, 470px" alt="The Mayabee online shop, a custom storefront built by Sakib Islam" loading="eager" fetchpriority="high" />
        </div>
        <div class="browser c-front">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>usetabby.com</span></div>
          <Picture src={tabby.shot} formats={['avif', 'webp']} widths={[420, 640]} sizes="(max-width: 900px) 58vw, 340px" alt="The Tabby website, built by Sakib Islam" loading="eager" />
        </div>
        <p class="h-stat"><small>Mayabee</small><b>Store + <em>dashboard</em></b></p>
      </div>
    </div>
  </section>

  <section class="trust-band" aria-label="Track record">
    <div class="wrap">
      <dl class="trust-nums">
        {trust.map((t) => <div><dt>{t.n}</dt><dd>{t.label}</dd></div>)}
      </dl>
      <div class="logo-row" aria-label="Clients">
        <p class="label">Built for</p>
        <ul>
          {logos.map((c) => (
            <li>
              <Picture src={c.logo} formats={['avif', 'webp']} widths={[Math.round(c.logo.width * 60 / c.logo.height), Math.round(c.logo.width * 90 / c.logo.height)]} sizes={`${Math.round(c.logo.width * 30 / c.logo.height)}px`} alt={c.name} loading="lazy" decoding="async" />
              {c.showName && <span aria-hidden="true">{c.name}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="services" class="wrap sec-pad">
    <div class="row-head">
      <div style="display: grid; gap: 0.9rem">
        <h2>My services</h2>
      </div>
      <a href="/full-stack-developer/">Hire a full stack developer →</a>
    </div>
    <ul class="kit kit-links svc4">
      {svc.map((r) => (
        <li>
          <div class="kit-art"><ServiceArt slug={r.slug} /></div>
          <h3><a href={r.href}>{r.name}</a></h3>
          <p class="muted">{r.what}</p>
          <ul class="tags">{r.gets.map((g) => <li>{g}</li>)}</ul>
          <p class="muted" style="font-size: 0.9375rem">{r.proof}</p>
        </li>
      ))}
    </ul>
    <p class="muted" style="margin-top: 1.5rem">Website slow, broken or hacked? <a class="more-link" href="/wordpress-repair/">Website repair</a>, <a class="more-link" href="/website-care/">speed fixes</a> and <a class="more-link" href="/wordpress-malware-removal/">malware removal</a> are part of website care.</p>
  </section>

  <section id="who" class="wrap" style="padding: 0 0 var(--sec)">
    <div class="row-head">
      <h2>Who I help</h2>
      <a href="/for/">All the pages →</a>
    </div>
    <ul class="kit kit-links">
      {icps.map((i) => <li><h3><a href={`/for/${i.slug}/`}>{i.name}</a></h3><p class="muted">{i.short}.</p></li>)}
    </ul>
  </section>

  <section id="work" class="wrap" style="padding: 0 0 var(--sec)">
    <div class="row-head">
      <h2>Recent projects</h2>
      <a href="/work/mayabee/">Start with Mayabee →</a>
    </div>
    <div class="mosaic">
      {mosaic.map((w, i) => (
        <a href={`/work/${w.slug}/`}>
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i>{i < 2 && <span>{new URL(w.clientUrl).hostname.replace('www.', '')}</span>}</div>
            <Picture src={w.img} formats={['avif', 'webp']} widths={i < 2 ? [640, 960, 1280] : [480, 720, 960]} sizes={i < 2 ? '(max-width: 900px) 100vw, 620px' : '(max-width: 900px) 100vw, 420px'} alt={`${w.client} website`} loading="lazy" />
          </div>
          <span class="tag">{w.client} · <b>{w.chip}</b></span>
        </a>
      ))}
    </div>
  </section>

    <section id="tools" class="wrap sec-pad">
    <div class="row-head">
      <div style="display: grid; gap: 0.9rem">
        <p class="label">Tools</p>
        <h2>Tools I use to build and host websites</h2>
      </div>
    </div>
    <div class="tools">
      {toolGroups.map((g) => (
        <div class="tool-group">
          <h3>{g.name}</h3>
          {g.note && <p class="muted" style="font-size: 0.9375rem">{g.note}</p>}
          <ul>{g.items.map(([n, d, l]) => <li><svg class="tool-logo" viewBox={`0 0 ${toolLogos[l].box} ${toolLogos[l].box}`} width="28" height="28" role="img" aria-label={`${n} logo`}><path d={toolLogos[l].path} /></svg><span class="tool-text"><b>{n}</b><span class="muted">{d}</span></span></li>)}</ul>
        </div>
      ))}
      <div class="tool-group tool-host">
        <h3>Hosting</h3>
        <ul><li><svg class="tool-logo" viewBox={`0 0 ${toolLogos.hostinger.box} ${toolLogos.hostinger.box}`} width="28" height="28" role="img" aria-label="Hostinger logo"><path d={toolLogos.hostinger.path} /></svg><span class="tool-text"><b>Hostinger</b><span class="muted">where I host my own websites, including this one and the Mayabee shop</span></span></li></ul>
        <p class="muted" style="font-size: 0.9375rem">I am a Hostinger affiliate partner. If you sign up through <a class="more-link" href={site.hostinger} target="_blank" rel="sponsored noopener">my Hostinger link</a>, I may earn a commission at no extra cost to you.</p>
      </div>
    </div>
  </section>

  <section id="about" class="sec-line sec-pad">
    <div class="wrap about">
      <figure class="about-photo">
        <div class="h-panel">
          <Picture src={photo} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 900px) 90vw, 480px" alt="Sakib Islam, full stack web developer" loading="lazy" />
        </div>
        <figcaption class="mono mut">Sakib Islam · Dhaka, working remotely</figcaption>
      </figure>
      <div class="about-copy">
        <p class="label">About</p>
        <h2>About Sakib Islam</h2>
        <p class="mut">Just me: a full stack web developer in Dhaka, working remotely for companies in the US and UK. No account managers and no hand-offs, so the person who answers your email is the one who designs and builds your site. I also founded Wrkbase, a platform for tasks, attendance, time tracking, payroll and team chat, with an AI agent that runs approved actions.</p>
        <ol class="timeline">
          {experience.map((e) => (
            <li><span class="yr">{e.yr}</span><span><strong>{e.role}</strong><br /><span class="mut" style="font-size: 0.9375rem">{e.org}</span></span><span class="kind">{e.kind}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="agency-band sec-pad">
    <div class="wrap agency-grid">
      <div class="agency-copy">
        <p class="label">For agencies</p>
        <h2><span class="ln">White-label WordPress</span> <span class="ln">development for agencies</span></h2>
        <p class="mut">I build your agency's Figma designs in WordPress. You review the work on a staging site, then it launches under your brand. You keep the client; nothing I hand over carries my name.</p>
        <div class="hero-actions">
          <a class="btn" href="/white-label-wordpress-development/">See how white-label works</a>
          <a class="btn btn-ghost" href="/contact/?type=agency">Send a design</a>
        </div>
      </div>
      <div class="agency-side">
        <figure class="agency-quote">
          <blockquote>&ldquo;highly responsive, communicative, and consistently delivers work on time&rdquo;</blockquote>
          <figcaption><b>Shamsi Nur</b> · Musemind, a design agency I built for</figcaption>
        </figure>
        <dl class="agency-terms">
          <div><dt>Per site</dt><dd>from {usd(prices.agencySite)}</dd></div>
          <div><dt>Hourly</dt><dd>{usd(prices.agencyHour)}/h</dd></div>
          <div><dt>NDA</dt><dd>on request</dd></div>
          <div><dt>Your client</dt><dd>never contacted</dd></div>
        </dl>
      </div>
    </div>
  </section>

  

  <section class="wrap" style="padding: var(--sec) 0 0">
    <div class="row-head"><div style="display: grid; gap: 0.9rem"><p class="label">Prices in US dollars</p><h2>Starting prices</h2></div><a href="/white-label-wordpress-development/">Agencies: from {usd(prices.agencySite)} a site →</a></div>
    <PriceCards plans={plans} compact />
    <p class="mut" style="margin: 1rem 0 clamp(2.5rem, 6vw, 4rem); font-size: 0.9375rem">Every job gets a written quote before work starts.</p>
  </section>

  <section class="rv-band sec-pad" aria-label="Recommendations" data-rv>
    <div class="wrap rv-grid">
      <div class="rv-side">
        <p class="label">Recommendations</p>
        <h2>Client recommendations</h2>
        <div class="rv-people" role="tablist" aria-label="Choose a recommendation">
          {reviews.map((r, i) => (
            <button type="button" role="tab" class:list={['rv-person', { on: i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} data-rv-to={i}>
              <span class="rv-ini" aria-hidden="true">{initials(r.name)}</span>
              <span class="rv-who"><b>{r.name}</b><small>{r.role}</small></span>
              <i class="rv-bar" aria-hidden="true"></i>
            </button>
          ))}
        </div>
        <p class="mut rv-src">Quoted word for word from <a href={allReviewsUrl} target="_blank" rel="noopener">my LinkedIn recommendations</a>.</p>
      </div>
      <div class="rv-card" aria-live="polite">
        <span class="rv-mark" aria-hidden="true">&ldquo;</span>
        <div class="rv-stack">
          {reviews.map((r, i) => (
            <figure class:list={['rv-item', { on: i === 0 }]}>
              <blockquote>{r.text}</blockquote>
              <figcaption><span class="rv-ini" aria-hidden="true">{initials(r.name)}</span><span><strong>{r.name}</strong><span>{r.role} · {r.date}</span></span></figcaption>
            </figure>
          ))}
        </div>
        <div class="rv-foot">
          <span class="mono mut"><span data-rv-pos>01</span> / {String(reviews.length).padStart(2, '0')}</span>
          <div class="rv-nav">
            <button type="button" aria-label="Previous recommendation" data-rv-prev><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
            <button type="button" aria-label="Next recommendation" data-rv-next><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="sec-line sec-pad">
      <div class="wrap">
        <div class="row-head">
          <h2>Guides for your website</h2>
          <a href="/blog/">All posts →</a>
        </div>
        <div class="post-grid">
          {posts.slice(0, 3).map((p) => (
            <a class="post-card" href={`/blog/${p.slug}/`}>
              <PostImage post={p} />
              <small>{p.topic}</small>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Connect />
</Base>

<script>
  // Recommendations: one at a time, chosen from the list or with previous and next. It moves on by itself every
  // 8 seconds (the bar under the current name fills), pauses while the pointer or focus is inside, and never
  // auto-advances for visitors who prefer reduced motion. Without script every quote shows.
  const box = document.querySelector('[data-rv]');
  if (box) {
    const items = [...box.querySelectorAll('.rv-item')], people = [...box.querySelectorAll('.rv-person')], pos = box.querySelector('[data-rv-pos]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer = 0, paused = false, visible = false;
    const restart = () => {
      clearTimeout(timer);
      box.classList.remove('auto'); void box.offsetWidth;
      if (still || paused || !visible) return;
      box.classList.add('auto');
      timer = setTimeout(() => show(i + 1), 8000);
    };
    const show = (n) => {
      i = (n + items.length) % items.length;
      items.forEach((el, k) => el.classList.toggle('on', k === i));
      people.forEach((el, k) => { el.classList.toggle('on', k === i); el.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
      pos.textContent = String(i + 1).padStart(2, '0');
      restart();
    };
    box.querySelector('[data-rv-prev]').addEventListener('click', () => show(i - 1));
    box.querySelector('[data-rv-next]').addEventListener('click', () => show(i + 1));
    people.forEach((btn, k) => btn.addEventListener('click', () => show(k)));
    const pause = (v) => { paused = v; restart(); };
    box.addEventListener('pointerenter', () => pause(true));
    box.addEventListener('pointerleave', () => pause(false));
    box.addEventListener('focusin', () => pause(true));
    box.addEventListener('focusout', () => pause(false));
    box.classList.add('ready');
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; restart(); }).observe(box);
  }
</script>
