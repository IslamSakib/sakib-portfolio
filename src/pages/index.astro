---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.astro';
import PostImage from '../components/PostImage.astro';
import PriceCards from '../components/PriceCards.astro';
import photo from '../assets/sakib-islam.jpg';
import appShot from '../assets/work/extra/wrkbase-1.jpg';
import shopPhoto from '../assets/photos/restaurant-owner-with-menu.jpg';
import agencyPhoto from '../assets/photos/developer-at-window-laptop.jpg';
import speedPhoto from '../assets/photos/mobile-app-in-hand.jpg';
import fixPhoto from '../assets/photos/code-on-laptop.jpg';
import carePhoto from '../assets/photos/dashboard-on-laptop.jpg';
import buildPhoto from '../assets/photos/shopping-on-store-website.jpg';
import { site } from '../site.js';
import { services } from '../services.js';
import { work } from '../work.js';
import { reviews, initials, allReviewsUrl } from '../reviews.js';
import { clients, clientCount } from '../clients.js';
import { posts } from '../blog.js';
import { prices, usd } from '../prices.js';

// Focus keyword for this page. It must appear in the title, the description and the H1 (scripts/seo-check.mjs).
const focus = 'WordPress developer';
const title = 'WordPress Developer for Businesses & Agencies | Sakib Islam';
const description =
  'Sakib Islam is a senior WordPress developer: speed fixes, repairs and care plans for businesses, and white-label WordPress builds for agencies.';

const shot = (slug) => work.find((w) => w.slug === slug);
const tabby = shot('tabby');
// Selected work: the first is shown large. Wrkbase is shown by its app screen, the rest by their home pages.
const mosaic = ['tabby', 'tubeonai', 'open-alliance-learning', 'wrkbase', 'pixmge'].map(shot).map((w) => ({ ...w, img: w.slug === 'wrkbase' ? appShot : w.shot }));

// Trust numbers. Each can be checked: the client list is in src/clients.js (Sakib's own list of sites built or fixed),
// full-time WordPress work starts at Oxford International School in Feb 2023, and the two results are from the
// TubeOnAI and Tabby case studies.
// The logo row shows only the best-known clients; the full list stays in src/clients.js.
const featured = ['Tabby', 'TubeOnAI', 'Moneybag', 'Wrkbase', 'Pixmge', 'Oxford International School'];
const logos = featured.map((n) => clients.find((c) => c.name === n)).filter(Boolean);
const trust = [
  { n: `${clientCount}+`, label: 'client websites built or fixed' },
  { n: '3+', label: 'years building WordPress full-time' },
  { n: '70%', label: 'faster page loads for TubeOnAI, 5 s down to 1.5 s' },
  { n: '90+', label: 'Core Web Vitals at launch for Tabby' },
];
const experience = [
  { yr: '2026 →', role: 'IT Executive', org: 'Open Academy London, online education', kind: 'Full-time' },
  { yr: '2026 →', role: 'Founder', org: 'Wrkbase, team management SaaS', kind: 'Own product' },
  { yr: '2025 →', role: 'WordPress developer', org: 'Tabby, AI bookkeeping (US)', kind: 'Freelance' },
  { yr: '2025', role: 'Payment gateway plugin', org: 'Moneybag, fintech', kind: 'Project' },
  { yr: '2024', role: 'WordPress developer', org: 'TubeOnAI, AI summaries', kind: 'Part-time' },
  { yr: '2023', role: 'WordPress developer', org: 'Oxford International School, Dhaka', kind: 'Full-time' },
];
const plans = [
  { name: 'Care plan', for: 'Keep a working site safe and current.', price: usd(prices.care), unit: '/mo', billing: 'Cancel any month', items: ['Updates tested before they go live', 'Daily off-site backups', 'Urgent reply within 24 hours'], cta: 'Start a plan', href: '/contact/?plan=care', featured: true, badge: 'Ongoing' },
  { name: 'Broken site fix', for: 'One problem, fixed at the cause.', price: usd(prices.fix), unit: ' from', billing: 'One-off', items: ['White screen, broken form or plugin conflict', 'The cause found and written down', 'One clean fix, not a patch'], cta: 'Fix my site', href: '/contact/?need=broken' },
  { name: 'Speed fix', for: 'A slow site made fast on mobile.', price: usd(prices.speed), unit: ' from', billing: 'Per site', items: ['Caching, images and plugins fixed at the cause', 'Before and after on PageSpeed Insights', 'Numbers you can check yourself'], cta: 'Speed it up', href: '/contact/?need=speed' },
  { name: 'Custom build', for: 'A WordPress or WooCommerce site from scratch.', price: usd(prices.build), unit: ' from', billing: 'Fixed quote', items: ['Custom theme and plugins', 'WooCommerce, payments and integrations', 'Built to load fast and survive updates'], cta: 'Start a build', href: '/contact/?need=build' },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: 'Senior WordPress developer',
    email: site.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
    url: Astro.site,
    image: { '@type': 'ImageObject', url: new URL(photo.src, Astro.site), width: photo.width, height: photo.height, caption: 'Sakib Islam, WordPress developer' },
    telephone: site.phone,
    sameAs: [site.linkedin, site.wrkbase, site.github, site.facebook].filter(Boolean),
    knowsAbout: ['WordPress development', 'WordPress maintenance', 'WordPress speed optimization', 'Core Web Vitals', 'WooCommerce', 'White-label WordPress development', 'SaaS development'],
    makesOffer: [
      { slug: 'wordpress-maintenance', name: 'WordPress maintenance' },
      ...services.map((sv) => ({ slug: sv.slug, name: sv.name })),
      { slug: 'white-label-wordpress-development', name: 'White-label WordPress development' },
    ].map((sv) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.name, url: new URL(`/${sv.slug}/`, Astro.site) } })),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: Astro.site },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus}>
  <section class="h-hero wrap">
    <div class="h-grid">
      <div class="h-copy">
        <h1><span class="eyebrow">Senior WordPress developer</span><span class="ln">Fast WordPress sites</span> <span class="ln">that keep working.</span></h1>
        <p class="lead">I fix, speed up and look after WordPress sites for businesses, and build designs in WordPress for agencies, under their name.</p>
        <div class="btn-row">
          <a class="btn" href="/contact/">Get a free site check</a>
          <a class="btn btn-ghost" href="/white-label-wordpress-development/">For agencies</a>
        </div>
        <p class="mono mut h-meta"><span>Dhaka, remote</span> <span>Overlaps US and UK hours</span> <span>Reply within 24 hours</span></p>
      </div>
      <div class="h-collage" aria-label="Sites I built">
        <div class="browser c-back">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>usetabby.com</span></div>
          <Picture src={tabby.shot} formats={['avif', 'webp']} widths={[560, 860]} sizes="(max-width: 900px) 78vw, 470px" alt="The Tabby website, built by Sakib Islam" loading="eager" fetchpriority="high" />
        </div>
        <div class="browser c-front">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>tubeonai.com</span></div>
          <Picture src={shot('tubeonai').shot} formats={['avif', 'webp']} widths={[420, 640]} sizes="(max-width: 900px) 58vw, 340px" alt="The TubeOnAI website, built by Sakib Islam" loading="eager" />
        </div>
        <p class="h-stat"><small>TubeOnAI load time</small><b>5 s → <em>1.5 s</em></b></p>
      </div>
    </div>
  </section>

  <section class="trust-band" aria-label="Track record">
    <div class="wrap">
      <dl class="trust-nums">
        {trust.map((t) => <div><dt>{t.n}</dt><dd>{t.label}</dd></div>)}
      </dl>
      <div class="logo-row" aria-label="Clients">
        <p class="label">Built for</p>
        <ul>
          {logos.map((c) => (
            <li>
              <img src={c.logo.src} width={c.logo.width} height={c.logo.height} alt={c.name} loading="lazy" decoding="async" />
              {c.showName && <span aria-hidden="true">{c.name}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding: var(--sec) 0 1.25rem">
    <div class="paths" style={`--a1:${shopPhoto.width / shopPhoto.height}; --a2:${agencyPhoto.width / agencyPhoto.height}`}>
      <a class="path" href="/wordpress-maintenance/">
        <Picture src={shopPhoto} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 720px" alt="A restaurant owner holding a menu in her dimly lit dining room" loading="lazy" />
        <div class="path-cap">
          <p class="label">I run a business <span aria-hidden="true">→</span></p>
          <h2>Slow, broken or nobody looking after it?</h2>
          <p class="tile-note">TubeOnAI load time: 5.0 s → 1.5 s</p>
        </div>
      </a>
      <a class="path" href="/white-label-wordpress-development/">
        <Picture src={agencyPhoto} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 600px" alt="A developer working on a laptop by a café window at dusk" loading="lazy" />
        <div class="path-cap">
          <p class="label">I run an agency <span aria-hidden="true">→</span></p>
          <h2>Your design, built in WordPress under your name.</h2>
          <p class="tile-note">Tabby and TubeOnAI: built from Figma</p>
        </div>
      </a>
    </div>
  </section>

  <section id="services" class="wrap" style="padding: 0 0 var(--sec)">
    <h2 class="sr-only">Services</h2>
    <div class="bento">
      <div class="bento-row">
      <a class="tile span-7" href="/wordpress-speed-optimization/" style={`--a:${speedPhoto.width / speedPhoto.height}`}>
        <Picture class="tile-img" src={speedPhoto} formats={['avif', 'webp']} widths={[640, 960]} loading="lazy" sizes="(max-width: 900px) 100vw, 700px" alt="A phone showing a fast mobile app screen" />
        <p class="label">Speed</p>
        <h3>Speed fixed at the cause.</h3>
        <p class="tile-note">Tabby: Core Web Vitals above 90 at launch</p>
      </a>
      <a class="tile span-5" href="/wordpress-maintenance/#fix" style={`--a:${fixPhoto.width / fixPhoto.height}`}>
        <Picture class="tile-img" src={fixPhoto} formats={['avif', 'webp']} widths={[640, 960]} loading="lazy" sizes="(max-width: 900px) 100vw, 500px" alt="Code open on a laptop on a desk" />
        <p class="label">Fixes</p>
        <h3>Sites that keep breaking, fixed once.</h3>
        <p class="tile-note">Two cache plugins out, one caching layer in</p>
      </a>
      </div>
      <div class="bento-row">
      <a class="tile span-5" href="/wordpress-maintenance/" style={`--a:${carePhoto.width / carePhoto.height}`}>
        <Picture class="tile-img" src={carePhoto} formats={['avif', 'webp']} widths={[640, 960]} loading="lazy" sizes="(max-width: 900px) 100vw, 500px" alt="A website dashboard with charts on a laptop" />
        <p class="label">Care plans · from {usd(prices.care)}/mo</p>
        <h3>One developer who knows your site.</h3>
        <p class="tile-note">Updates, backups, security, and a report every month</p>
      </a>
      <a class="tile span-7" href="/wordpress-development/" style={`--a:${buildPhoto.width / buildPhoto.height}`}>
        <Picture class="tile-img" src={buildPhoto} formats={['avif', 'webp']} widths={[640, 960]} loading="lazy" sizes="(max-width: 900px) 100vw, 700px" alt="Someone shopping on an online store on a laptop" />
        <p class="label">Builds</p>
        <h3>Custom WordPress and WooCommerce, down to the payment gateway.</h3>
        <p class="tile-note">Moneybag: a custom payment plugin for WooCommerce</p>
      </a>
      </div>
    </div>
  </section>

  <section id="work" class="wrap" style="padding: 0 0 var(--sec)">
    <div class="row-head">
      <h2>Selected work</h2>
      <a href="/work/tabby/">Start with Tabby →</a>
    </div>
    <div class="mosaic">
      {mosaic.map((w, i) => (
        <a href={`/work/${w.slug}/`}>
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i>{i < 2 && <span>{new URL(w.clientUrl).hostname.replace('www.', '')}</span>}</div>
            <Picture src={w.img} formats={['avif', 'webp']} widths={i < 2 ? [640, 960, 1280] : [480, 720, 960]} sizes={i < 2 ? '(max-width: 900px) 100vw, 620px' : '(max-width: 900px) 100vw, 420px'} alt={`${w.client} website`} loading="lazy" />
          </div>
          <span class="tag">{w.client} · <b>{w.chip}</b></span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="sec-line sec-pad">
    <div class="wrap about">
      <figure class="about-photo">
        <div class="h-panel">
          <Picture src={photo} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 900px) 90vw, 480px" alt="Sakib Islam, WordPress developer" loading="lazy" />
        </div>
        <figcaption class="mono mut">Sakib Islam · Dhaka, working remotely</figcaption>
      </figure>
      <div class="about-copy">
        <p class="label">About</p>
        <h2>I find what is actually wrong, then fix it once.</h2>
        <p class="mut">WordPress developer in Dhaka, working alone and remotely for companies in the US and UK. I also built and run my own SaaS product, Wrkbase.</p>
        <ol class="timeline">
          {experience.map((e) => (
            <li><span class="yr">{e.yr}</span><span><strong>{e.role}</strong><br /><span class="mut" style="font-size: 0.9375rem">{e.org}</span></span><span class="kind">{e.kind}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="agency-band sec-pad">
    <div class="wrap agency-grid">
      <div class="agency-copy">
        <p class="label">For agencies · white-label</p>
        <h2>From your Figma to launch, under your name.</h2>
        <p class="mut">You keep the client and the credit. I build the site on staging, you review it, and it launches with your name on it. Nothing I hand over carries mine.</p>
        <div class="hero-actions">
          <a class="btn" href="/white-label-wordpress-development/">How it works</a>
          <a class="btn btn-ghost" href="/contact/?type=agency">Send a design</a>
        </div>
        <p class="mono mut" style="font-size: 0.8125rem">From {usd(prices.agencySite)} per site or {usd(prices.agencyHour)}/h · NDA on request</p>
      </div>
      <ol class="flow-steps">
        {[
          { t: 'You send the design', d: 'Figma, page list and date. A quote and a date come back first.', p: 'M3 3h18v18H3zM3 9h18M9 21V9' },
          { t: 'I build on staging', d: 'A private staging site, with progress updates in your Slack.', p: 'M8 7l-5 5 5 5M16 7l5 5-5 5' },
          { t: 'You review', d: 'Checked on phone and desktop, with mobile speed tested before you see it.', p: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 100 6 3 3 0 000-6z' },
          { t: 'You launch it', d: 'Under your brand, with handoff notes for your team.', p: 'M5 12l5 5L20 7' },
        ].map((st, i) => (
          <li>
            <span class="fs-num">0{i + 1}</span>
            <span class="fs-icon"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={st.p} /></svg></span>
            <div><strong>{st.t}</strong><p class="mut">{st.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="motto" aria-label="How I work">
    <div class="wrap" style="display: grid; gap: 1.25rem">
      <p class="label">How I work</p>
      <p class="big"><span class="ln">Fix the cause,</span> <em class="ln">not the symptom.</em></p>
    </div>
  </section>

  <section class="wrap" style="padding: var(--sec) 0 0">
    <div class="row-head"><div style="display: grid; gap: 0.9rem"><p class="label">Starting prices, USD</p><h2>Clear prices, written quote first.</h2></div><a href="/white-label-wordpress-development/">Agencies: from {usd(prices.agencySite)} a site →</a></div>
    <PriceCards plans={plans} compact />
    <p class="mut" style="margin-top: 1rem; font-size: 0.9375rem">Every job gets a written quote before work starts.</p>
  </section>

  <section class="wrap rv" style="padding: var(--sec) 0" aria-label="Recommendations" data-rv>
    <div class="rv-head">
      <p class="label">What they said · <span data-rv-pos>01</span> / {String(reviews.length).padStart(2, '0')}</p>
      <div class="rv-nav">
        <button type="button" aria-label="Previous recommendation" data-rv-prev><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
        <button type="button" aria-label="Next recommendation" data-rv-next><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    </div>
    <div aria-live="polite">
      {reviews.map((r, i) => (
        <figure class:list={['rv-item', { on: i === 0 }]}>
          <span class="rv-ini" aria-hidden="true">{initials(r.name)}</span>
          <div>
            <blockquote>&ldquo;{r.text}&rdquo;</blockquote>
            <figcaption><strong>{r.name}</strong><br /><span>{r.role}</span></figcaption>
          </div>
        </figure>
      ))}
    </div>
    <p class="mut" style="font-size: 0.9375rem">Quoted word for word from <a href={allReviewsUrl} target="_blank" rel="noopener">my LinkedIn recommendations</a>.</p>
  </section>

  {posts.length > 0 && (
    <section class="sec-line sec-pad">
      <div class="wrap">
        <div class="row-head">
          <h2>From the blog</h2>
          <a href="/blog/">All posts →</a>
        </div>
        <div class="post-grid">
          {posts.slice(0, 3).map((p) => (
            <a class="post-card" href={`/blog/${p.slug}/`}>
              <PostImage post={p} />
              <small>{p.topic}</small>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Connect />
</Base>

<script>
  // Recommendations: one at a time with previous and next. Without script all of them show in a column.
  const box = document.querySelector('[data-rv]');
  if (box) {
    const items = [...box.querySelectorAll('.rv-item')], pos = box.querySelector('[data-rv-pos]');
    let i = 0;
    const show = (n) => {
      i = (n + items.length) % items.length;
      items.forEach((el, k) => el.classList.toggle('on', k === i));
      pos.textContent = String(i + 1).padStart(2, '0');
    };
    box.querySelector('[data-rv-prev]').addEventListener('click', () => show(i - 1));
    box.querySelector('[data-rv-next]').addEventListener('click', () => show(i + 1));
    box.classList.add('ready');
  }
</script>
