---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Audit from '../components/Audit.astro';
import { services } from '../services.js';
import photo from '../assets/sakib-islam-cut.png';
import appShot from '../assets/work/extra/wrkbase-1.jpg';
import { site } from '../site.js';
import { work } from '../work.js';
import { clients } from '../clients.js';
import WorkReel from '../components/WorkReel.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';

// Focus keyword for this page. It must appear in the title, the description and the H1 (scripts/seo-check.mjs).
const focus = 'WordPress developer';
const title = 'WordPress Developer for Startups & SaaS | Sakib Islam';
const description =
  'Sakib Islam is a WordPress developer for startups and SaaS teams: custom builds, speed fixes, custom web products and AI agents. See the work and results.';

const pad = (n) => String(n).padStart(2, '0');
// A service as a command name: "Speed and rescue" becomes "speed-and-rescue".
const cmd = (sv) => sv.name.toLowerCase().replace(/\s+/g, '-');

// The headline is split into words so each one can animate in. The word in `hot` takes the accent colour.
// Three fixed lines on desktop; on phones the words wrap naturally.
const headline = ['WordPress developer', 'building fast sites for', 'SaaS and AI startups.'].map((line) => line.split(' '));
const hot = ['fast'];

// Trust numbers. Each one can be checked: the client list is the strip above, the recommendations are on LinkedIn,
// the countries are where those clients are, and the saved signups figure is from the TubeOnAI case study.
const proof = [
  { num: 25, dec: 0, prefix: '', suffix: '+', label: 'client websites built or fixed' },
  { num: 12, dec: 0, prefix: '', suffix: '', label: 'LinkedIn recommendations from founders, managers and teammates' },
  { num: 4, dec: 0, prefix: '', suffix: '', label: 'countries served: US, UK, Denmark and Bangladesh' },
  { num: 6, dec: 0, prefix: '$', suffix: 'K', label: 'in signups saved for TubeOnAI by ending its downtime (estimate)' },
];

const faq = [
  {
    q: 'Can you fix a WordPress site that keeps going down?',
    a: "Yes. I start by finding the cause, not by adding another plugin. On TubeOnAI the downtime came from leftover cache plugin files clashing with the host's own speed plugin. I removed them, kept one caching layer, and load time went from 5 seconds to 1.5.",
  },
  {
    q: 'What does a WordPress developer like you take on?',
    a: 'All of it, front end and back end. That covers custom themes, custom features, plugin development, WooCommerce and payments, integrations with other tools, security and speed. A build from a Figma design is one kind of project, not the only one.',
  },
  {
    q: 'Do you only work with WordPress?',
    a: 'No. I also build custom web products. Wrkbase, a team management platform with an AI agent, is my own product: I designed it, built the software and built its website without WordPress.',
  },
  {
    q: 'What does a WordPress speed fix involve?',
    a: 'I measure the site with PageSpeed Insights, then work through what the report shows: caching set up once and properly, unused CSS and JavaScript removed, images resized and served in modern formats, and heavy page-builder layouts rebuilt. You get the before and after numbers.',
  },
  {
    q: 'How do you measure the result?',
    a: 'With Google PageSpeed Insights and Core Web Vitals, on mobile, before and after the work. You see the same numbers I do, and you can run the test yourself at any time.',
  },
  {
    q: 'Do you offer ongoing maintenance?',
    a: "Yes. I still maintain and update Tabby's website after building it, and I can do the same for a site I have built or fixed for you.",
  },
  {
    q: 'Can you add AI to my product or website?',
    a: 'Yes. I build AI agents that take actions inside a product, connect language model APIs to sites and apps, add chatbots to WordPress, and automate repeat work. The agent inside Wrkbase, my own platform, is the worked example.',
  },
  {
    q: 'How much does a project cost?',
    a: 'It depends on the scope, so I look first. Send me the site or the brief, I tell you what I would check or build and in what order, and you get a written quote before any work starts.',
  },
  {
    q: 'Do you work with companies outside Bangladesh?',
    a: 'Yes. I work remotely from Dhaka. Tabby is a US product, and I have built for clients in Denmark and the UK.',
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: site.role,
    address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
    url: Astro.site,
    image: { '@type': 'ImageObject', url: new URL(photo.src, Astro.site), width: photo.width, height: photo.height, caption: 'Sakib Islam, WordPress developer and founder of Wrkbase' },
    telephone: site.phone,
    sameAs: [site.linkedin, site.wrkbase, site.github, site.facebook].filter(Boolean),
    knowsAbout: ['WordPress development', 'WordPress plugin development', 'WordPress speed optimization', 'Core Web Vitals', 'WooCommerce', 'SaaS development', 'AI agents', 'LLM integration'],
    makesOffer: services.map((sv) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.name, url: new URL(`/${sv.slug}/`, Astro.site) } })),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: Astro.site },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus}>
  <section class="hero">
    <canvas class="dots" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">WordPress, custom development and AI</p>
        <h1>
          {headline.map((line, l) => (
            <span class="hl">
              {line.map((word, i) => (
                <Fragment>
                  <span class="w" style={`--i:${headline.slice(0, l).flat().length + i}`}>{hot.includes(word) ? <em>{word}</em> : word}</span>{' '}
                </Fragment>
              ))}
            </span>
          ))}
        </h1>
        <p class="lead">
          I build and fix WordPress sites, custom web products and AI agents for SaaS and AI startups. One developer who finds the real cause, ships on schedule and shows you the numbers.
        </p>
        <div class="hero-actions">
          <button class="btn" type="button" data-chat-open data-magnet>Start a project</button>
          <a class="btn btn-ghost" href="#audit" data-magnet>Get a free audit</a>
        </div>
      </div>
      <div class="hero-photo">
        <figure class="portrait" data-tilt>
          <Picture src={photo} formats={['avif', 'webp']} widths={[460, 800]} sizes="(max-width: 860px) 92vw, 460px" width={460} height={460} alt="Sakib Islam, WordPress developer and founder of Wrkbase" loading="eager" fetchpriority="high" />
          <span class="badge">Founder, Wrkbase</span>
          <figcaption><b>Dhaka, Bangladesh</b><span data-clock>GMT+6</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="clients" aria-label="Clients">
    <div class="wrap"><p>Built for</p></div>
    <div class="marquee">
      <div class="track">
        {[0, 1].map((copy) =>
          clients.map((c) => (
            <span class="chip" aria-hidden={copy === 1 ? 'true' : undefined}>
              {c.logo && <img src={c.logo.src} width={c.logo.width} height={c.logo.height} alt={c.showName ? '' : c.name} loading="lazy" decoding="async" />}
              {c.showName && <b class="wm wm-heavy" style="--ink:#f5f4ef">{c.name}</b>}
              {c.mark && (
                <b class:list={['wm', `wm-${c.mark.style}`]} style={`--ink:${c.mark.color}`}>
                  {c.mark.badge && <i aria-hidden="true">{c.mark.badge}</i>}
                  <span>{c.mark.text || c.name}</span>
                </b>
              )}
            </span>
          )),
        )}
      </div>
    </div>
  </section>

  <section class="proof-wrap" aria-label="Results">
    <dl class="wrap proof" data-reveal>
      {proof.map((p) => (
        <div>
          <dt class="num">{p.prefix}<span data-count={p.num} data-dec={p.dec}>{p.num.toFixed(p.dec)}</span>{p.suffix}</dt>
          <dd>{p.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="work" class="sec tint-a">
    <div class="wrap">
      <WorkReel items={work} label={`${pad(work.length)} projects`} title="Selected work" lead="Real client sites. Pick one to see what I built, the result and the live link." />
    </div>
  </section>

  <section id="wrkbase" class="sec band band-grid">
    <div class="wrap showcase">
      <div class="showcase-copy">
        <div data-reveal>
          <p class="label">My own product</p>
          <h2>Wrkbase, software I designed and built</h2>
        </div>
        <div data-reveal style="--d:0.1s">
          <p class="lead">
            A team management platform, custom-built from the database to the dashboard, with an AI agent that does the admin after you approve it.
          </p>
          <ul>
            <li>Tasks, time tracking, attendance, leave and payroll</li>
            <li>An AI agent that shows every step before it acts</li>
            <li>Role-based access and a full audit log</li>
          </ul>
          <p class="card-links">
            <a href="/work/wrkbase/">Case study</a>
            <a href={site.wrkbase} target="_blank" rel="noopener">mywrkbase.com ↗</a>
          </p>
        </div>
      </div>
      <div class="stage">
        <div class="frame">
          <Picture
            src={appShot}
            formats={['avif', 'webp']}
            widths={[640, 960, 1568]}
            sizes="(max-width: 1200px) 100vw, 1160px"
            alt="The Wrkbase dashboard showing tasks, attendance, performance and payroll for a company"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="sec">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Services</p>
        <h2>What I can do for you</h2>
      </div>
      <div class="console term" data-reel data-interval="6500" data-reveal>
        <div class="console-bar"><i></i><i></i><i></i><span>services</span><b>{services.length} available</b></div>
        <div class="term-body">
          <div class="term-side">
            <p class="line you">$ sakib --services</p>
            <div class="term-list" role="tablist" aria-label="Services" aria-orientation="vertical">
              {services.map((sv, i) => (
                <button type="button" role="tab" id={`svc-tab-${i}`} aria-controls={`svc-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <span class="idx">{pad(i + 1)}</span>
                  <span class="cmd">{cmd(sv)}</span>
                </button>
              ))}
            </div>
            <p class="line sys hint">Pick a service to see what is included.</p>
          </div>
          <div class="term-out" data-reel-stage>
            {services.map((sv, i) => (
              <div class:list={['term-panel', { on: i === 0 }]} role="tabpanel" id={`svc-panel-${i}`} aria-labelledby={`svc-tab-${i}`}>
                <p class="line you" style="--i:0">$ sakib open {cmd(sv)}</p>
                <h3 class="line" style="--i:1"><a href={`/${sv.slug}/`}>{sv.name}</a></h3>
                <p class="line sys" style="--i:2">{sv.short}</p>
                {sv.includes.map((item, k) => <p class="line ok" style={`--i:${k + 3}`}>{item.name}</p>)}
                <p class="line plan" style={`--i:${sv.includes.length + 3}`}>
                  proof:{' '}
                  {sv.proof.map((slug, k) => (
                    <Fragment>{k > 0 && ', '}<a href={`/work/${slug}/`}>{work.find((w) => w.slug === slug).client}</a></Fragment>
                  ))}
                </p>
                <p class="line plan" style={`--i:${sv.includes.length + 4}`}><a href={`/${sv.slug}/`}>open the full page</a><span class="caret" aria-hidden="true"></span></p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Audit />

  <Process />

  <Reviews />

  <section id="faq" class="sec band band-glow">
    <div class="wrap faq-grid">
      <div class="faq-side">
        <p class="label">FAQ</p>
        <h2>Questions clients ask</h2>
        <p class="muted">Something else on your mind? Ask me directly.</p>
        <a class="btn btn-ghost btn-small" href={site.whatsapp} target="_blank" rel="noopener">Ask on WhatsApp</a>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details name="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

<script>
  import '../scripts/reel.js';
</script>
