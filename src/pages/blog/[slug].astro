---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Connect from '../../components/Connect.astro';
import PostImage from '../../components/PostImage.astro';
import { posts, longDate } from '../../blog.js';
import { site } from '../../site.js';
import { prices, usd } from '../../prices.js';
import photo from '../../assets/sakib-islam.png';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = p;
const url = new URL(Astro.url.pathname, Astro.site);
const more = posts.filter((x) => x.slug !== p.slug).slice(0, 3);
// The side card points to the service the post is about.
const cards = {
  'wordpress-maintenance': { label: 'Care plans', price: `${usd(prices.care)}`, unit: '/mo', text: 'Everything in this post, done for you every month.', href: '/wordpress-maintenance/', cta: 'See the plans' },
  'wordpress-speed-optimization': { label: 'Speed fix', price: `from ${usd(prices.speed)}`, unit: '', text: 'Measured before and after on mobile PageSpeed Insights.', href: '/wordpress-speed-optimization/', cta: 'See speed work' },
  'white-label-wordpress-development': { label: 'For agencies', price: `${usd(prices.agencyHour)}`, unit: '/h', text: 'Your design, built in WordPress under your name.', href: '/white-label-wordpress-development/', cta: 'How it works' },
};
const card = cards[p.service] || cards['wordpress-maintenance'];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.date,
    dateModified: p.updated || p.date,
    author: { '@type': 'Person', name: site.name, url: Astro.site },
    publisher: { '@type': 'Person', name: site.name, url: Astro.site },
    image: { '@type': 'ImageObject', url: new URL(p.og, Astro.site), width: 1200, height: 630 },
    mainEntityOfPage: url,
    keywords: p.focus,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site) },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];
---
<Base title={p.seoTitle} description={p.description} jsonld={jsonld} focus={p.focus} ogImage={p.og} ogAlt={p.imageAlt}>
  <header class="wrap post-head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog/">Blog</a><span>/</span><span>{p.topic}</span></nav>
    <h1>{p.title}</h1>
    <div class="byline">
      <Image src={photo} width={88} height={88} alt="" />
      <span>{site.name} · WordPress developer<br /><time datetime={p.date}>{longDate(p.date)}</time> · {p.minutes} min read</span>
    </div>
  </header>

  <div class="wrap post-cover"><PostImage post={p} sizes="(max-width: 1280px) 100vw, 1240px" eager /></div>

  <div class="wrap post-layout">
    <nav class="toc" aria-label="On this page">
      <p class="label">On this page</p>
      {p.headings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <article class="article">
      <Content />
      <div class="author">
        <Image src={photo} width={112} height={112} alt="" />
        <p>Written by {site.name}, a WordPress developer who builds and looks after sites for businesses and agencies. <a href="/#about">About my work</a></p>
      </div>
    </article>
    <aside class="rail">
      <div class="side-card">
        <p class="label">{card.label}</p>
        <b>{card.price}<small class="mut" style="font-size: 1rem">{card.unit}</small></b>
        <p class="mut" style="font-size: 0.9375rem">{card.text}</p>
        <a class="btn" href={card.href}>{card.cta}</a>
      </div>
    </aside>
  </div>

  {more.length > 0 && (
    <section class="sec-line" style="padding: 4rem 0 5rem">
      <div class="wrap" style="display: grid; gap: 1.5rem">
        <h2 style="font-size: 2rem">Keep reading</h2>
        <div class="post-grid">
          {more.map((x) => (
            <a class="post-card" href={`/blog/${x.slug}/`}>
              <small>{x.topic}</small>
              <h3>{x.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Connect />
</Base>

<script>
  // Contents list: marks the section being read. The list itself stays in view (position: sticky in pages.css).
  const links = [...document.querySelectorAll('.toc a')];
  const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const heads = [...document.querySelectorAll('.article h2[id]')];
  if (links.length && heads.length && 'IntersectionObserver' in window) {
    const mark = (id) => links.forEach((a) => a.classList.toggle('on', a === byId.get(id)));
    const seen = new Set();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
      // The highest heading in the reading zone wins; between headings the last one stays marked.
      const first = heads.find((h) => seen.has(h.id));
      if (first) mark(first.id);
    }, { rootMargin: '-110px 0px -60% 0px' });
    heads.forEach((h) => io.observe(h));
  }
</script>
