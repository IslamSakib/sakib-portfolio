---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Connect from '../../components/Connect.astro';
import PostImage from '../../components/PostImage.astro';
import PostActions from '../../components/PostActions.astro';
import { posts, longDate } from '../../blog.js';
import { site } from '../../site.js';
import { prices, usd } from '../../prices.js';
import photo from '../../assets/sakib-islam.jpg';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = p;
const url = new URL(Astro.url.pathname, Astro.site);
// Keep reading: posts on the same topic first, then posts pointing to the same service, then the newest.
const score = (x) => (x.topic === p.topic ? 2 : 0) + (x.service === p.service ? 1 : 0);
const more = posts.filter((x) => x.slug !== p.slug).sort((a, b) => score(b) - score(a)).slice(0, 3);
// The side card points to the service the post is about.
const cards = {
  'wordpress-maintenance': { label: 'Care plans', price: `${usd(prices.care)}`, unit: '/mo', text: 'Everything in this post, done for you every month.', href: '/website-care/', cta: 'See the plans' },
  'wordpress-speed-optimization': { label: 'Speed fix', price: `from ${usd(prices.speed)}`, unit: '', text: 'Measured before and after on mobile PageSpeed Insights.', href: '/website-care/', cta: 'See speed work' },
  'white-label-wordpress-development': { label: 'For agencies', price: `${usd(prices.agencyHour)}`, unit: '/h', text: 'Your design, built in WordPress under your name.', href: '/white-label-wordpress-development/', cta: 'How it works' },
  'white-label-wordpress-maintenance': { label: 'White-label care', price: `${usd(prices.agencyCare)}`, unit: '/site/mo', text: 'Your clients’ sites looked after, reported under your brand.', href: '/white-label-wordpress-maintenance/', cta: 'How it works' },
  'wordpress-care-plans': { label: 'Care plans', price: `${usd(prices.care)}`, unit: '/mo', text: 'Everything in this post, done for you every month.', href: '/wordpress-care-plans/', cta: 'Compare the plans' },
  'wordpress-repair': { label: 'Repair', price: `from ${usd(prices.fix)}`, unit: '', text: 'Broken today? Fixed at the cause, with the cause written down.', href: '/wordpress-repair/', cta: 'Get it fixed' },
  'wordpress-malware-removal': { label: 'Malware removal', price: `from ${usd(prices.malware)}`, unit: '', text: 'Cleaned by hand, and the way in closed so it stays clean.', href: '/wordpress-malware-removal/', cta: 'Clean my site' },
};
cards['custom-web-development'] = { label: 'Custom website development', price: 'Quoted', unit: '', text: 'A website, shop or web app built from design to backend, with a written price first.', href: '/custom-web-development/', cta: 'Get a free quote' };
cards['wordpress-development'] = { label: 'WordPress development', price: `from ${usd(prices.build)}`, unit: '', text: 'Custom themes, plugins and WooCommerce, built to your design.', href: '/wordpress-development/', cta: 'See WordPress work' };
const card = cards[p.service] || cards['wordpress-maintenance'];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.date,
    dateModified: p.updated || p.date,
    author: { '@type': 'Person', name: site.name, url: Astro.site },
    publisher: { '@type': 'Person', name: site.name, url: Astro.site },
    image: { '@type': 'ImageObject', url: new URL(p.og, Astro.site), width: 1200, height: 630 },
    mainEntityOfPage: url,
    keywords: p.focus,
  },
  ...(p.faq ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site) },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];
---
<Base title={p.seoTitle} description={p.description} jsonld={jsonld} focus={p.focus} ogImage={p.og} ogAlt={p.imageAlt}>
  <header class="wrap post-head hero-bg">
    <canvas class="dots dots-bleed" aria-hidden="true"></canvas>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog/">Blog</a><span>/</span><span>{p.topic}</span></nav>
    <h1>{p.title}</h1>
    <div class="byline">
      <Image src={photo} width={88} height={88} alt="Sakib Islam" />
      <span>{site.name} · WordPress developer<br /><time datetime={p.date}>{longDate(p.date)}</time> · {p.minutes} min read</span>
    </div>
  </header>

  <div class="wrap post-cover"><PostImage post={p} sizes="(max-width: 1280px) 100vw, 1240px" eager /></div>

  {p.stats && (
    <section class="wrap post-stats" aria-label="By the numbers">
      <p class="label">By the numbers</p>
      <dl>
        {p.stats.map((st) => (
          <div>
            <dt>{st.value}</dt>
            <dd>{st.label}</dd>
            <dd class="src">{st.url ? <a href={st.url} target="_blank" rel="noopener">{st.source} ↗</a> : st.source}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <div class="wrap post-layout">
    <nav class="toc" aria-label="On this page">
      <p class="label">On this page</p>
      {p.headings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      {p.faq && <a href="#questions">Common questions</a>}
    </nav>
    <article class="article">
      <Content />
      {p.faq && (
        <section class="post-faq" aria-labelledby="questions">
          <h2 id="questions">Common questions</h2>
          {p.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}
      {p.sources && (
        <aside class="sources" aria-label="Sources">
          <h2>Sources</h2>
          <ol>
            {p.sources.map((src) => <li><a href={src.url} target="_blank" rel="noopener">{src.name}</a></li>)}
          </ol>
        </aside>
      )}
      <div class="post-actions-m"><PostActions url={url.href} title={p.title} /></div>
      <div class="author">
        <Image src={photo} width={112} height={112} alt="Sakib Islam, WordPress developer" />
        <p>Written by {site.name}, a WordPress developer who builds and looks after sites for businesses and agencies. <a href="/#about">About my work</a></p>
      </div>
    </article>
    <aside class="rail">
      <div class="rail-stick">
      <div class="side-card">
        <p class="label">{card.label}</p>
        <b>{card.price}<small class="mut" style="font-size: 1rem">{card.unit}</small></b>
        <p class="mut" style="font-size: 0.9375rem">{card.text}</p>
        <a class="btn" href={card.href}>{card.cta}</a>
      </div>
      <PostActions url={url.href} title={p.title} />
      </div>
    </aside>
  </div>

  {more.length > 0 && (
    <section class="sec-line" style="padding: 4rem 0 5rem">
      <div class="wrap" style="display: grid; gap: 1.5rem">
        <h2 style="font-size: 2rem">Keep reading</h2>
        <div class="post-grid">
          {more.map((x) => (
            <a class="post-card" href={`/blog/${x.slug}/`}>
              <PostImage post={x} />
              <small>{x.topic} · {x.minutes} min read</small>
              <h3>{x.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Connect />
</Base>

<script>
  // Contents list: marks the section being read. The list itself stays in view (position: sticky in pages.css).
  const links = [...document.querySelectorAll('.toc a')];
  const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const heads = [...document.querySelectorAll('.article h2[id]')];
  if (links.length && heads.length && 'IntersectionObserver' in window) {
    const mark = (id) => links.forEach((a) => a.classList.toggle('on', a === byId.get(id)));
    const seen = new Set();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
      // The highest heading in the reading zone wins; between headings the last one stays marked.
      const first = heads.find((h) => seen.has(h.id));
      if (first) mark(first.id);
    }, { rootMargin: '-110px 0px -60% 0px' });
    heads.forEach((h) => io.observe(h));
  }
</script>
