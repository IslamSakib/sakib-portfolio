---
import Base from '../../layouts/Base.astro';
import Connect from '../../components/Connect.astro';
import PostImage from '../../components/PostImage.astro';
import { posts, topics, longDate } from '../../blog.js';
import { site } from '../../site.js';

const focus = 'WordPress work';
const title = 'Notes from Real WordPress Work | Sakib Islam Blog';
const description = 'Notes from real WordPress work: speed, fixes and maintenance, builds, and working with agencies. Written by Sakib Islam from client projects.';
const [first, ...rest] = posts;
// Only topics that have posts get a filter button.
const used = topics.filter((t) => posts.some((p) => p.topic === t));

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${site.name} blog`,
    url: new URL('/blog/', Astro.site),
    author: { '@type': 'Person', name: site.name, url: Astro.site },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: new URL(`/blog/${p.slug}/`, Astro.site), datePublished: p.date })),
  },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus}>
  <section class="wrap sec-pad hero-bg" style="padding-bottom: 2.5rem; display: grid; gap: 1.5rem">
    <h1 style="font-size: clamp(2.5rem, 5vw, 4.6rem)">Notes from real WordPress work</h1>
    {used.length > 1 && (
      <div class="chips" role="group" aria-label="Filter posts by topic" data-filter>
        <button type="button" aria-pressed="true" data-topic="">All</button>
        {used.map((t) => <button type="button" aria-pressed="false" data-topic={t}>{t}</button>)}
      </div>
    )}
  </section>

  {first && (
    <section class="wrap" style="padding-bottom: 4rem" data-topic-item={first.topic}>
      <a class="post-feature" href={`/blog/${first.slug}/`}>
        <PostImage post={first} sizes="(max-width: 900px) 100vw, 680px" eager />
        <div style="display: grid; gap: 1rem; justify-items: start">
          <span class="pill">{first.topic}</span>
          <h2>{first.title}</h2>
          <p class="mut">{first.description}</p>
          <p class="mono mut" style="font-size: 0.8125rem"><time datetime={first.date}>{longDate(first.date)}</time> · {first.minutes} min read</p>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="wrap sec-line" style="padding: 3.5rem 0 6rem">
      <div class="post-grid">
        {rest.map((p) => (
          <a class="post-card" href={`/blog/${p.slug}/`} data-topic-item={p.topic}>
            <PostImage post={p} />
            <small>{p.topic} · {p.minutes} min read</small>
            <h3>{p.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <Connect />
</Base>

<script>
  // Topic filter: hides posts from other topics. Without script every post shows.
  const bar = document.querySelector('[data-filter]');
  bar?.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll('[data-topic-item]').forEach((el) => {
      el.hidden = !!b.dataset.topic && el.dataset.topicItem !== b.dataset.topic;
    });
  });
</script>
