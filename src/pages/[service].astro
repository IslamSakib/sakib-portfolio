---
// One page per service in src/services.js, in the same order as the home page: hero with an animated picture, result numbers,
// the problem as a before and after, what is included, proof, process, recommendations, FAQ and the contact band.
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import ServiceArt from '../components/ServiceArt.astro';
import WorkReel from '../components/WorkReel.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { site } from '../site.js';
import { services } from '../services.js';
import { work } from '../work.js';
import { iconFor } from '../icons.js';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const pad = (n) => String(n).padStart(2, '0');
// Keeps the last two words of a line together, so no line ends on a single word.
const tidy = (t) => t.replace(/ (\S+)$/, '\u00a0$1');
const proof = s.proof.map((slug) => work.find((w) => w.slug === slug)).filter(Boolean);
const others = services.filter((o) => o.slug !== s.slug);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.focus,
    description: s.description,
    url,
    areaServed: 'Worldwide',
    provider: { '@type': 'Person', name: site.name, url: Astro.site, jobTitle: site.role },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: s.name, item: url },
    ],
  },
];
---
<Base title={s.title} description={s.description} jsonld={jsonld} focus={s.focus} ogImage={`/og-${s.slug}.jpg`} ogAlt={`${s.h1} Sakib Islam, ${s.name}.`}>
  <section class="page-head svc-hero">
    <canvas class="dots" aria-hidden="true"></canvas>
    <div class="wrap svc-grid">
      <div class="svc-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>{s.name}</span>
        </nav>
        <h1>{s.h1Lines.map((l) => <Fragment><span class="hl">{l}</span>{' '}</Fragment>)}</h1>
        <p class="lead">{tidy(s.lead)}</p>
        <div class="hero-actions">
          <button class="btn" type="button" data-chat-open>Start a project</button>
          <a class="btn btn-ghost" href="#proof">See the proof</a>
        </div>
        <ul class="tags">{s.chips.map((c) => <li>{c}</li>)}</ul>
      </div>
      <ServiceArt slug={s.slug} />
    </div>
  </section>

  {proof.length > 1 && (
  <section class="proof-wrap" aria-label="Results">
    <dl class="wrap proof" style={`--cols:${proof.length}`} data-reveal>
      {proof.map((w) => (
        <div>
          <dt class="num">{w.metricValue}</dt>
          <dd><b>{w.client}.</b> {w.metricLabel}</dd>
        </div>
      ))}
    </dl>
  </section>
  )}

  <section class="sec band band-glow">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.problemTitle}</h2>
      </div>
      <div class="versus">
        <div class="vs-card vs-no" data-reveal>
          <p class="label">The usual way</p>
          <ul>{s.before.map((t) => <li>{t}</li>)}</ul>
        </div>
        <span class="vs-arrow" aria-hidden="true">→</span>
        <div class="vs-card vs-yes" data-reveal style="--d:0.12s" data-spot>
          <p class="label">How I do it</p>
          <ul>{s.after.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="section-head">
        <h2>What you get</h2>
      </div>
      <ul class="kit">
        {s.includes.map((item, i) => (
          <li data-reveal style={`--d:${(i % 3) * 0.07}s`}>
            <span class="kit-top">
              <svg class="kit-ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={iconFor(item.name)} /></svg>
              <span class="idx">{pad(i + 1)}</span>
            </span>
            <h3>{item.name}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="proof" class="sec tint-a">
    <div class="wrap">
      <WorkReel items={proof} title="Where I have done this" lead={proof.length > 1 ? "Pick a project to see the result and the live site." : "The worked example, with the result and the live site."} />
    </div>
  </section>

  <Process />

  <Reviews />

  <Faq items={s.faq} title={`Questions about ${s.focus}`} />

  <section class="sec">
    <div class="wrap">
      <div class="section-head">
        <h2>Other things I do</h2>
      </div>
      <ul class="kit kit-links">
        {others.map((o, i) => (
          <li data-reveal style={`--d:${i * 0.07}s`}>
            <div class="kit-art"><ServiceArt slug={o.slug} /></div>
            <h3><a href={`/${o.slug}/`}>{o.name}</a></h3>
            <p class="muted">{o.short}</p>
            <ul class="tags">{o.chips.slice(0, 3).map((c) => <li>{c}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta heading={`Need ${s.focus}?`} />
</Base>

<script>
  import '../scripts/reel.js';
</script>
