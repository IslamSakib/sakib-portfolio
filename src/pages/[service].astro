---
// The three pillar pages: custom website development, web application development, WordPress development.
import ServicePage from '../components/ServicePage.astro';
import { pillars, kidsOf } from '../children.js';
export function getStaticPaths() {
  return pillars.map((s) => ({ params: { service: s.slug }, props: { s, kids: s.kids, siblings: pillars.filter((o) => o.slug !== s.slug) } }));
}
const { s, kids, siblings } = Astro.props;
---
<ServicePage s={s} kids={kids} siblings={siblings} />
