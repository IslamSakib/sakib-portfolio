---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../site.js';
import { work } from '../../work.js';
import { reviews } from '../../reviews.js';

export function getStaticPaths() {
  return work.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, next: work[(i + 1) % work.length] },
  }));
}

const { w, next } = Astro.props;
const { Content } = w;
const url = new URL(Astro.url.pathname, Astro.site);
const host = new URL(w.clientUrl).hostname.replace('www.', '');
// A review is shown on a case study when its role line names the client.
const review = reviews.find((r) => r.role.includes(w.client));

const faqSchema = w.faq
  ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: w.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
  : [];

const jsonld = [
  ...faqSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: w.title,
    description: w.description,
    author: { '@type': 'Person', name: site.name, url: Astro.site },
    keywords: [w.focus, ...w.stack].join(', '),
    // The case studies were written and first published with the site on 11 October 2026.
    datePublished: '2026-10-11',
    dateModified: '2026-10-11',
    publisher: { '@type': 'Person', name: site.name, url: Astro.site },
    about: w.client,
    image: { '@type': 'ImageObject', url: new URL(w.shot.src, Astro.site), width: w.shot.width, height: w.shot.height, caption: `${w.client} website home page, built by Sakib Islam` },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/#work', Astro.site) },
      { '@type': 'ListItem', position: 3, name: w.client, item: url },
    ],
  },
];
---
<Base title={w.seoTitle} description={w.description} jsonld={jsonld} focus={w.focus}>
  <article class="wrap">
    <header class="case-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/#work">Work</a><span>/</span><span>{w.client}</span>
      </nav>
      <h1>{w.title.replace(/ (\S+)$/, ' $1')}</h1>
      <p class="lead">{w.summary}</p>
      <div class="hero-actions">
        <a class="btn" href={w.clientUrl} target="_blank" rel="noopener">Visit {host} ↗</a>
      </div>
      <dl class="facts">
        <div><dt>Client</dt><dd>{w.client}</dd></div>
        <div><dt>Role</dt><dd>{w.role}</dd></div>
        <div><dt>When</dt><dd>{w.period}</dd></div>
        <div><dt>Work</dt><dd>{w.stack.slice(0, 2).join(', ')}</dd></div>
      </dl>
    </header>

    <figure class="case-shot frame" style={`view-transition-name: shot-${w.slug}`}>
      <Picture
        src={w.shot}
        formats={['avif', 'webp']}
        widths={[640, 1120, 1440]}
        sizes="(max-width: 1160px) 100vw, 1120px"
        alt={`${w.client} website home page, built by Sakib Islam`}
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="case-body">
      <div class="prose"><Content /></div>
      <aside class="case-aside">
        <div class="metric">
          <strong class="num">{w.metricValue}</strong>
          <span>{w.metricLabel}</span>
        </div>
        <ul class="tags">{w.stack.map((s) => <li>{s}</li>)}</ul>
      </aside>
    </div>

    {w.extra.length > 0 && (
      <div class="gallery">
        {w.extra.map((img, i) => (
          <figure class="frame">
            <Picture
              src={img}
              formats={['avif', 'webp']}
              widths={[640, 1120, 1568]}
              sizes="(max-width: 1160px) 100vw, 1120px"
              alt={`${w.client} product screen ${i + 1}`}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    )}

    {w.faq && (
      <section class="case-faq">
        <h2>Common questions</h2>
        <div class="faq">
          {w.faq.map((f) => (
            <details name="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {review && (
      <blockquote class="case-quote">
        <p>&ldquo;{review.text.replace(/ (\S+)$/, ' $1')}&rdquo;</p>
        <footer>
          {review.url ? (
            <a href={review.url} target="_blank" rel="noopener">{review.name} ↗</a>
          ) : (
            review.name
          )}, {review.role}
        </footer>
      </blockquote>
    )}

    <div class="next">
      <a href={`/work/${next.slug}/`}>Next: {next.client}</a>
      <a class="btn btn-ghost" href="/#work">All work</a>
    </div>
  </article>
  <Cta heading={`Want a result like ${w.client}?`} />
</Base>
