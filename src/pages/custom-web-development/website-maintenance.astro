---
import { heroLead } from '../../heroLead.js';
// Website care: the monthly care plans, plus single fixes (repair, speed, malware) for a site in trouble today.
// Replaces the old /custom-web-development/website-maintenance/ and /custom-web-development/website-maintenance/ pages, which now 301 here.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Connect from '../../components/Connect.astro';
import PriceCards from '../../components/PriceCards.astro';
import { site } from '../../site.js';
import { work } from '../../work.js';
import { prices, usd, carePlans } from '../../prices.js';
import heroPhoto from '../../assets/visuals/svc-care.jpg';

const focus = 'website maintenance services';
const title = 'Website Maintenance Services from $149/mo | Sakib Islam';
const description =
  'Website maintenance services from $149/mo: tested updates, backups, monitoring and fixes. See the plans.';
const url = new URL(Astro.url.pathname, Astro.site);
const tabby = work.find((w) => w.slug === 'tabby').shot;

const weeks = [
  { t: 'Updates', d: 'Tested first', p: 'M21 12a9 9 0 11-3-6.7M21 4v5h-5' },
  { t: 'Backups', d: 'Daily, off server', p: 'M4 5c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3' },
  { t: 'Security', d: 'Monitored daily', p: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z' },
  { t: 'Report', d: 'Plain English', p: 'M6 3h9l4 4v14H6zM9 12h7M9 16h5' },
];
const plans = carePlans;
const faq = [
  { q: 'What do website maintenance services include?', a: 'Updates to the platform, theme and plugins (or the libraries in custom code), tested before they go live; daily backups kept off the server; uptime and security monitoring; and time for small changes. You also get a monthly report written for a non-technical reader.' },
  { q: 'Do you look after WooCommerce stores?', a: 'Yes. WooCommerce maintenance adds checks a content site does not need: the checkout, payment gateway and order emails are tested after every update. Stores are quoted separately because they need more of that testing.' },
  { q: 'Why one developer instead of a WordPress maintenance company?', a: 'A maintenance company passes your site between support staff. Here the same senior developer handles every update and fix, so nobody has to learn your site again each time something breaks.' },
  { q: 'What happens if the site goes down at night?', a: 'Monitoring tells me when it happens, and urgent problems get a reply within 24 hours. I work from Dhaka, so a US or UK night is my working day.' },
  { q: 'Can you take over a site another developer built?', a: 'Yes. I start by reading what is there: the theme, the plugins, the errors and what changed recently. You get a short list of what is wrong and what I would fix first before the plan starts.' },
  { q: 'Can I cancel?', a: 'Yes, any month. You keep every login and own everything; I work through my own user account, which you can remove.' },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Website care',
    serviceType: focus,
    description,
    url,
    provider: { '@type': 'Person', name: site.name, url: Astro.site },
    offers: [
      { '@type': 'Offer', name: 'Care', priceSpecification: { '@type': 'UnitPriceSpecification', price: prices.care, priceCurrency: 'USD', unitText: 'month' } },
      { '@type': 'Offer', name: 'Care + development', priceSpecification: { '@type': 'UnitPriceSpecification', price: prices.carePlus, priceCurrency: 'USD', unitText: 'month' } },
      { '@type': 'Offer', name: 'Single fix', priceSpecification: { '@type': 'PriceSpecification', minPrice: prices.fix, priceCurrency: 'USD' } },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: 'Website care', item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus} ogImage="/og-website-care.jpg" ogAlt={title}>
  <section class="p-hero wrap hero-bg">
    <canvas class="dots dots-bleed" aria-hidden="true"></canvas>
    <div class="p-grid">
      <div class="p-copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Website care</span></nav>
        <p class="eyebrow">Website care · nobody looking after your site?</p>
        <h1><span class="ln">Website maintenance</span> <span class="ln">services, so your site</span> <span class="ln">stops breaking.</span></h1>
        <p class="lead">{heroLead(`Website maintenance services for when nobody's looking after your site, whether it runs on WordPress or is custom built. I test every update before it goes live, keep daily backups off your server, watch for downtime and hacks, and make your small changes. One developer who knows your site, not a ticket queue.`, 'Website maintenance services')}</p>
        <div class="btn-row">
          <a class="btn" href="/contact/?plan=care">Start a care plan</a>
          <a class="btn btn-ghost" href="#fix">Fix one problem first</a>
        </div>
      </div>
      <div class="p-photo">
      <Picture src={heroPhoto} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 660px" alt="A monthly care report for the Tabby website: updates, backups, monitoring, changes and a plain-English report" loading="eager" fetchpriority="high" />
      <ol class="month" aria-label="A month on a care plan">
        {weeks.map((w, i) => (
          <li class:list={[{ last: i === 3 }]}>
            <small>Week {i + 1}</small>
            <svg class="icon" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d={w.p} /></svg>
            <strong>{w.t}</strong>
            <span>{w.d}</span>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <section class="on-surface sec-pad">
    <div class="wrap two-col">
      <div style="display: grid; gap: 1.1rem; justify-items: start">
        <p class="label">Why sites fall apart</p>
        <h2>Why a website with no maintainer breaks</h2>
        <p class="mut">A WordPress site breaks when nobody owns the updates. TubeOnAI kept going down because old cache plugins were fighting the host's own; I removed them and kept one caching layer.</p>
        <a class="more-link" href="/work/tubeonai/">Read the case study →</a>
      </div>
      <figure class="result-card" aria-label="TubeOnAI: load time fell from 5 seconds to 1.5 seconds and server load fell 60 percent">
        <div class="bars">
          <div><span class="mut">Before</span><i></i><b>5.0 s</b></div>
          <div class="after"><span class="mut">After</span><span><i></i></span><b>1.5 s</b></div>
        </div>
        <div class="result-nums">
          <div><b>−60%</b><span>server load</span></div>
          <div><b>Stopped</b><span>the repeated downtime</span></div>
        </div>
        <figcaption class="mono mut" style="font-size: 0.75rem">TubeOnAI, at the time of the work</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap sec-pad" style="padding-bottom: calc(var(--sec) * 0.6)">
    <div class="row-head"><h2>What website care costs you each month</h2></div>
    <PriceCards plans={plans} />
    <p class="mut" style="margin-top: 1.1rem; font-size: 0.9375rem">Stores and high-traffic sites are quoted separately. You keep every login. <a class="more-link" href="/wordpress-development/wordpress-maintenance/">Compare the care plans side by side →</a> · <a class="more-link" href="/blog/best-wordpress-maintenance-services/">Comparing providers? →</a> · <a class="more-link" href="/blog/wordpress-hosting-and-maintenance/">Hosting vs maintenance →</a></p>
  </section>

  <section id="fix" class="wrap" style="padding-bottom: var(--sec)">
    <div class="fix-panel">
      <div>
        <p class="label">Not ready for a plan?</p>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem)">Something broken or slow right now?</h2>
        <p class="mut">Single fixes start at {usd(prices.fix)}: a white screen, broken form or plugin conflict, with the cause written down. A slow site gets a measured speed fix from {usd(prices.speed)}, with before and after numbers on PageSpeed Insights. See <a href="/wordpress-development/wordpress-repair/">WordPress repair</a>, or <a href="/wordpress-development/wordpress-malware-removal/">malware removal</a> for a hacked site.</p>
      </div>
      <a class="btn" href="/contact/?need=broken">Fix my site from $50</a>
    </div>
  </section>

  <section class="sec-line sec-pad">
    <div class="wrap two-col">
      <figure class="quote-side" style="margin: 0">
        <span class="ini" aria-hidden="true">AA</span>
        <blockquote>&ldquo;continuous maintenance and updates on Tabby's website. He is very responsive&rdquo;</blockquote>
        <figcaption class="mut">Ahad Ali, CPA, Founder of Tabby</figcaption>
      </figure>
      <a class="browser" href="/work/tabby/"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>usetabby.com</span></div><Picture src={tabby} formats={['avif', 'webp']} widths={[480, 720, 1040]} sizes="(max-width: 900px) 100vw, 600px" alt="The Tabby website, built and maintained by Sakib Islam since 2025" loading="lazy" /></a>
    </div>
  </section>

  <section class="wrap sec-pad">
    <div class="row-head"><h2>What I need from you to start</h2></div>
    <ol class="start-steps">
      <li><span class="n">01</span><strong>An admin login for me</strong><span>In my own name.</span></li>
      <li><span class="n">02</span><strong>Hosting access</strong><span>Or the host's name.</span></li>
      <li><span class="n">03</span><strong>What bothers you today</strong><span>I check those first.</span></li>
    </ol>
  </section>

  <section class="wrap sec-pad" style="padding-top: 0">
    <div class="two-col" style="align-items: start">
      <h2>Your questions about website maintenance</h2>
      <div class="qa">
        {faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <Connect heading="Send me your website for a free check" />
</Base>
