---
import PlacePage from '../../components/PlacePage.astro';
import { roles } from '../../roles.js';
const role = roles['wordpress-developer'];
export function getStaticPaths() {
  return roles['wordpress-developer'].pages.map((p) => ({ params: { place: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<PlacePage role={role} p={p} />
