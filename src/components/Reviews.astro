---
// LinkedIn recommendations, laid out like the project reel: names on the left, the chosen recommendation set large in a
// panel on the right. Shared by the home page and the service pages, which must load src/scripts/reel.js.
import { reviews, allReviewsUrl } from '../reviews.js';
const pad = (n) => String(n).padStart(2, '0');
// Keeps the last two words of a quote together, so no line ends on a single word.
const tidy = (t) => t.replace(/ (\S+)$/, ' $1');
---
<section id="reviews" class="sec">
  <div class="wrap">
    <div class="reel quotes" data-reel data-interval="8000">
      <div class="reel-left">
        <div class="section-head">
          <h2>What people I have worked with say</h2>
          <p class="lead">Recommendations from clients and colleagues, copied word for word from my LinkedIn profile.</p>
        </div>
        <div class="reel-list" role="tablist" aria-label="Recommendations" aria-orientation="vertical">
          {reviews.map((r, i) => (
            <button type="button" role="tab" id={`rev-tab-${i}`} aria-controls={`rev-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="idx">{pad(i + 1)}</span>
              <span class="name">{r.name}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="quote-stage" data-reel-stage>
        {reviews.map((r, i) => (
          <blockquote class:list={['quote-panel', { on: i === 0 }]} role="tabpanel" id={`rev-panel-${i}`} aria-labelledby={`rev-tab-${i}`}>
            <div>
              <span class="qmark" aria-hidden="true">&ldquo;</span>
              <p>{tidy(r.text)}</p>
            </div>
            <footer>
              <span class="who"><b>{r.name}</b><span>{r.role}</span></span>
              <a href={allReviewsUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" /></svg>
                Read it on LinkedIn
              </a>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
    <p class="review-note">
      Every one of these can be checked on
      <a href={allReviewsUrl} target="_blank" rel="noopener">my LinkedIn recommendations ↗</a>.
    </p>
  </div>
</section>
