---
// Shared layout for the policy pages (service terms, privacy). A full-width hero with the "at a glance" facts, a sticky
// contents list that marks the section being read, and numbered section panels. Content is passed in as data; the text
// is written by the site owner's team of one (me), so it is rendered as HTML to allow inline links.
//   sections: [{ id, title, blocks: [{ p: 'html' } | { ul: ['html', ...] } | { note: 'html' }] }]
//   facts: [{ k: 'Cancel any month', v: 'One sentence.' }]
import Base from '../layouts/Base.astro';
import Connect from './Connect.astro';
import { Picture } from 'astro:assets';

const { title, description, focus, jsonld, ogImage, eyebrow, h1, lead, updated, image, imageAlt = '', facts = [], sections = [], connect = 'Send me your question' } = Astro.props;
const pad = (n) => String(n).padStart(2, '0');
---
<Base title={title} description={description} jsonld={jsonld} focus={focus} ogImage={ogImage} ogAlt={title}>
  <section class="pol-hero hero-bg">
    <canvas class="dots dots-bleed" aria-hidden="true"></canvas>
    <div class="wrap pol-grid">
      <div class="pol-head">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="lead">{lead}</p>
        <p class="pol-meta mono"><span>Last updated {updated}</span><span>Plain English</span><span>No small print</span></p>
      </div>
      {image && (
        <figure class="pol-art">
          <Picture src={image} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 560px" alt={imageAlt} loading="eager" fetchpriority="high" />
        </figure>
      )}
    </div>
    {facts.length > 0 && (
      <div class="wrap">
        <ul class="pol-facts" aria-label="At a glance">
          {facts.map((f) => <li><b>{f.k}</b><span>{f.v}</span></li>)}
        </ul>
      </div>
    )}
  </section>

  <section class="wrap pol-body">
    <nav class="pol-toc" aria-label="On this page">
      <p class="label">On this page</p>
      <ol>
        {sections.map((s, i) => <li><a href={`#${s.id}`} data-spy><span>{pad(i + 1)}</span>{s.title}</a></li>)}
      </ol>
    </nav>
    <div class="pol-main">
      {sections.map((s, i) => (
        <section class="pol-sec" id={s.id}>
          <span class="pol-n mono" aria-hidden="true">{pad(i + 1)}</span>
          <h2>{s.title}</h2>
          <div class="pol-copy">
            {s.blocks.map((b) => (
              b.p ? <p set:html={b.p} /> :
              b.ul ? <ul>{b.ul.map((li) => <li set:html={li} />)}</ul> :
              b.note ? <p class="pol-note" set:html={b.note} /> : null
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <Connect heading={connect} />
</Base>

<script>
  // Marks the contents link of the section being read. No motion, only a highlight.
  const links = [...document.querySelectorAll('[data-spy]')];
  const map = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { links.forEach((l) => l.classList.remove('on')); map.get(e.target.id)?.classList.add('on'); } });
  }, { rootMargin: '-20% 0px -70% 0px' });
  document.querySelectorAll('.pol-sec').forEach((s) => io.observe(s));
</script>

<style>
  .pol-hero { padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2.5rem, 4vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .pol-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .pol-grid:not(:has(.pol-art)) { grid-template-columns: minmax(0, 1fr); }
  .pol-art { margin: 0; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7); }
  .pol-art :global(img) { display: block; width: 100%; height: auto; }
  .pol-head { display: grid; gap: 1.25rem; justify-items: start; }
  .pol-head .eyebrow { margin: 0; }
  .pol-head h1 { font-size: clamp(2.5rem, 5.6vw, 4.75rem); max-width: 18ch; }
  .pol-head .lead { max-width: 62ch; }
  .pol-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8125rem; color: var(--muted); margin-top: 0.25rem; }
  .pol-meta span { padding: 0.35rem 0.75rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }

  .pol-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .pol-facts li { display: grid; gap: 0.5rem; align-content: start; padding: 1.4rem 1.5rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); transition: border-color 0.3s ease, translate 0.5s var(--ease); }
  .pol-facts li:hover { border-color: rgb(var(--accent-rgb) / 0.6); translate: 0 -4px; }
  .pol-facts b { font-family: var(--display); font-size: clamp(1.25rem, 1.8vw, 1.6rem); letter-spacing: -0.02em; color: var(--text); font-weight: 700; line-height: 1.15; }
  .pol-facts span { font-size: 0.9375rem; color: var(--muted); }

  .pol-body { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); padding: clamp(3rem, 6vw, 5rem) 0 var(--sec); align-items: start; }
  .pol-toc { position: sticky; top: 110px; display: grid; gap: 1rem; }
  .pol-toc ol { display: grid; gap: 0.15rem; }
  .pol-toc a { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0.25rem; padding: 0.55rem 0.75rem; border-left: 1px solid var(--line); color: var(--muted); font-size: 0.9375rem; text-decoration: none; line-height: 1.35; transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease; }
  .pol-toc a span { font-family: var(--mono); font-size: 0.75rem; padding-top: 0.15rem; color: var(--line-2); }
  .pol-toc a:hover { color: var(--text); border-color: var(--accent); }
  .pol-toc a.on { color: var(--text); border-color: var(--accent); background: rgb(var(--accent-rgb) / 0.08); }
  .pol-toc a.on span { color: var(--accent); }

  .pol-main { display: grid; gap: 1.25rem; min-width: 0; }
  .pol-sec { position: relative; display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); column-gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.4rem); border: 1px solid var(--line); border-radius: 16px; background: var(--surface); scroll-margin-top: 110px; }
  .pol-n { grid-row: 1 / span 2; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1; color: var(--accent); letter-spacing: -0.03em; }
  .pol-sec h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); max-width: none; }
  .pol-copy { grid-column: 2; display: grid; gap: 1rem; margin-top: 1rem; max-width: 74ch; }
  .pol-copy p, .pol-copy li { color: #d3d0c6; font-size: 1.0625rem; line-height: 1.65; }
  .pol-copy strong { color: var(--text); font-weight: 600; }
  .pol-copy a { color: var(--text); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .pol-copy ul { display: grid; gap: 0.7rem; }
  .pol-copy li { position: relative; padding-left: 1.5rem; }
  .pol-copy li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 0.7rem; height: 2px; background: var(--accent-fill); }
  .pol-note { padding: 1rem 1.2rem; border-left: 2px solid var(--accent); background: rgb(var(--accent-rgb) / 0.07); border-radius: 0 10px 10px 0; }

  @media (max-width: 1100px) { .pol-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .pol-grid { grid-template-columns: minmax(0, 1fr); }
    .pol-body { grid-template-columns: minmax(0, 1fr); }
    .pol-toc { position: static; }
    .pol-toc ol { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem; scrollbar-width: thin; }
    .pol-toc a { white-space: nowrap; border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 0.9rem; grid-template-columns: auto auto; gap: 0.5rem; }
    .pol-toc a.on { border-color: var(--accent); }
  }
  @media (max-width: 640px) {
    .pol-facts { grid-template-columns: minmax(0, 1fr); }
    .pol-sec { grid-template-columns: minmax(0, 1fr); }
    .pol-n { grid-row: auto; margin-bottom: 0.6rem; }
    .pol-copy { grid-column: 1; }
  }
  @media (hover: none) { .pol-facts li:hover { translate: none; } }
</style>
