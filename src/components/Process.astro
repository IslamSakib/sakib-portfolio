---
// "How I work": four steps, each with a photo of what happens in it. Shared by the home page and the service pages.
// The photos are decoration (empty alt); the step text carries the meaning.
import { Picture } from 'astro:assets';
import find from '../assets/visuals/step-find.jpg';
import fix from '../assets/visuals/step-fix.jpg';
import measure from '../assets/visuals/step-measure.jpg';
import hand from '../assets/visuals/step-hand.jpg';
const pad = (n) => String(n).padStart(2, '0');
const steps = [
  { img: find, name: 'Find the cause', text: 'I test the site, read the errors and check what changed before I touch anything.' },
  { img: fix, name: 'Fix the root', text: 'One clean fix where the problem lives, not a patch on top of it.' },
  { img: measure, name: 'Measure it', text: 'Before and after numbers from PageSpeed Insights that you can check yourself.' },
  { img: hand, name: 'Hand it over', text: 'You get notes on what was done, so the next change does not undo it.' },
];
---
<section id="process" class="sec tint-a">
  <div class="wrap">
    <div class="section-head">
      <h2>How I work</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li data-reveal style={`--d:${i * 0.1}s`}>
          <div class="pa"><Picture src={s.img} formats={['avif', 'webp']} widths={[400, 640]} sizes="(max-width: 900px) 100vw, 300px" alt="" loading="lazy" /></div>
          <span class="idx">Step {pad(i + 1)}</span>
          <h3>{s.name}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Each photo keeps its own proportions (nothing is cropped) */
  .pa { margin-bottom: 0.9rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .pa :global(img) { display: block; width: 100%; height: auto; transition: transform 1.2s var(--ease); }
  li:hover .pa :global(img) { transform: scale(1.04); }
</style>
