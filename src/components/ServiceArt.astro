---
// The animated picture in each service page's hero. One drawing per service, built from plain HTML and CSS:
// the parts appear one after another (--i sets the order), hold, then the loop starts again.
// Decorative only, so the whole figure is hidden from screen readers; the facts it shows are in the page text.
const { slug } = Astro.props;
---
<figure class:list={['art', `art-${slug}`]} aria-hidden="true" data-tilt>
  {slug === 'wordpress-development' && (
    <div class="art-frame">
      <div class="art-bar"><i></i><i></i><i></i><span>yoursite.com</span></div>
      <div class="wp">
        <div class="wp-nav seq" style="--i:0"><b></b><i></i><i></i><i></i><em></em></div>
        <div class="wp-hero seq" style="--i:1"><b></b><b></b><em></em></div>
        <div class="wp-cards">
          <span class="seq" style="--i:2"></span><span class="seq" style="--i:3"></span><span class="seq" style="--i:4"></span>
        </div>
        <div class="wp-pay seq" style="--i:6"><span>Checkout</span><b>Paid ✓</b></div>
      </div>
      <ul class="art-tags">
        <li class="seq" style="--i:1">theme</li>
        <li class="seq" style="--i:5">plugin</li>
        <li class="seq" style="--i:6">payments</li>
        <li class="seq" style="--i:7">integrations</li>
      </ul>
    </div>
  )}

  {slug === 'wordpress-speed-optimization' && (
    <div class="art-frame">
      <div class="art-bar"><i></i><i></i><i></i><span>load time, mobile</span></div>
      <div class="sp">
        <div class="sp-dial">
          <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" /><circle class="sp-ring" cx="60" cy="60" r="50" pathLength="100" /></svg>
          <p><b class="sp-before">5.0</b><b class="sp-after">1.5</b><span>seconds</span></p>
        </div>
        <div class="sp-rows">
          <p><span>Before</span><i class="sp-bar slow"></i><b>5 s</b></p>
          <p><span>After</span><i class="sp-bar fast"></i><b>1.5 s</b></p>
        </div>
      </div>
      <ul class="art-tags">
        <li class="seq" style="--i:1">one cache</li>
        <li class="seq" style="--i:3">lighter pages</li>
        <li class="seq" style="--i:5">right-size images</li>
      </ul>
      <p class="art-note">TubeOnAI, measured when I did the work</p>
    </div>
  )}

  {slug === 'custom-web-development' && (
    <div class="art-frame">
      <div class="art-bar"><i></i><i></i><i></i><span>your product</span></div>
      <div class="cd">
        <div class="cd-side"><b></b><i class="on"></i><i></i><i></i><i></i></div>
        <div class="cd-main">
          <div class="cd-tiles">
            <span class="seq" style="--i:0"><small>Tasks</small></span>
            <span class="seq" style="--i:1"><small>Time</small></span>
            <span class="seq" style="--i:2"><small>Payroll</small></span>
          </div>
          <div class="cd-chart seq" style="--i:3">
            {[38, 62, 45, 80, 58, 92, 70].map((h, k) => <i style={`--h:${h}%;--k:${k}`}></i>)}
          </div>
          <div class="cd-roles">
            <span class="seq" style="--i:5">Admin</span><span class="seq" style="--i:6">Manager</span><span class="seq" style="--i:7">Member</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'ai-development' && (
    <div class="art-frame">
      <div class="art-bar"><i></i><i></i><i></i><span>agent</span><em>waits for approval</em></div>
      <div class="ai">
        <p class="ai-you seq" style="--i:0">Approve this week's leave requests</p>
        <p class="ai-plan seq" style="--i:1">Plan, 3 steps</p>
        <p class="ai-step seq" style="--i:2">Read the 4 open requests</p>
        <p class="ai-step seq" style="--i:3">Check each against the leave balance</p>
        <p class="ai-step seq" style="--i:4">Approve 3, flag 1 for you</p>
        <p class="ai-ask seq" style="--i:5"><span>Run this plan?</span><b>Approve</b></p>
        <p class="ai-done seq" style="--i:7">Done. Every action is in the audit log.</p>
      </div>
    </div>
  )}
</figure>

<style>
  .art { position: relative; width: 100%; max-width: 520px; justify-self: end; }
  .art-frame { display: grid; gap: 1.1rem; padding-bottom: 1.25rem; background: var(--bg-deep); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8); font-family: var(--mono); font-size: 0.8125rem; color: var(--muted); }
  .art-frame > :not(.art-bar) { margin-inline: 1.25rem; }
  .art-bar { display: flex; align-items: center; gap: 0.4rem; height: 38px; padding: 0 1rem; background: var(--surface-2); border-bottom: 1px solid var(--line); font-size: 0.75rem; }
  .art-bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .art-bar span { margin-left: 0.6rem; }
  .art-bar em { margin-left: auto; font-style: normal; color: var(--accent); }
  .art-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .art-tags li { padding: 0.2rem 0.7rem; border: 1px solid rgb(var(--accent-rgb) / 0.5); border-radius: 999px; color: var(--accent-hi); font-size: 0.75rem; }
  .art-note { font-size: 0.6875rem; }

  /* One loop for every drawing: each part comes in at its turn, stays, and all leave together before the restart */
  .seq { animation: seq 9s var(--ease, ease) infinite both; animation-delay: calc(var(--i) * 0.45s); }
  @keyframes seq {
    0% { opacity: 0; transform: translateY(10px) scale(0.97); }
    6%, 82% { opacity: 1; transform: none; }
    92%, 100% { opacity: 0; transform: none; }
  }

  /* WordPress: a page assembling itself */
  .wp { display: grid; gap: 0.7rem; }
  .wp-nav { display: flex; align-items: center; gap: 0.5rem; }
  .wp-nav b { width: 22px; height: 22px; border-radius: 6px; background: var(--accent); }
  .wp-nav i { width: 34px; height: 6px; border-radius: 3px; background: var(--line); }
  .wp-nav i:first-of-type { margin-left: auto; }
  .wp-nav em { width: 56px; height: 20px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .wp-hero { display: grid; gap: 0.5rem; padding: 1.1rem; border-radius: 10px; background: linear-gradient(135deg, rgb(var(--accent-rgb) / 0.22), var(--surface)); border: 1px solid var(--line); }
  .wp-hero b { height: 10px; width: 70%; border-radius: 5px; background: var(--text); opacity: 0.85; }
  .wp-hero b + b { width: 46%; opacity: 0.4; }
  .wp-hero em { width: 84px; height: 24px; margin-top: 0.3rem; border-radius: 999px; background: var(--accent); }
  .wp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .wp-cards span { height: 62px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .wp-pay { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0.9rem; border-radius: 10px; border: 1px dashed rgb(var(--accent-rgb) / 0.6); color: var(--text); }
  .wp-pay b { color: #9fd8a8; font-weight: 500; }

  /* Speed: the dial empties from 5 seconds to 1.5 while the bars show the same two numbers */
  .sp { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: center; }
  .sp-dial { position: relative; width: 150px; }
  .sp-dial svg { display: block; rotate: -90deg; }
  .sp-dial circle { fill: none; stroke: var(--surface-2); stroke-width: 9; }
  .sp-dial .sp-ring { stroke: var(--accent); stroke-linecap: round; stroke-dasharray: 100; animation: ring 7s ease-in-out infinite; }
  .sp-dial p { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; }
  .sp-dial b { grid-area: 1 / 1; font-family: var(--display); font-size: 2.6rem; font-weight: 600; letter-spacing: -0.04em; color: var(--text); line-height: 1; }
  .sp-dial span { font-size: 0.6875rem; }
  .sp-before { animation: swapout 7s ease-in-out infinite; }
  .sp-after { color: var(--accent) !important; animation: swapin 7s ease-in-out infinite; }
  .sp-rows { display: grid; gap: 0.9rem; }
  .sp-rows p { display: grid; grid-template-columns: 3.4rem 1fr 2.6rem; gap: 0.6rem; align-items: center; }
  .sp-rows b { color: var(--text); font-weight: 500; text-align: right; }
  .sp-bar { height: 10px; border-radius: 5px; background: var(--line); transform-origin: 0 50%; animation: barin 7s ease-out infinite; }
  .sp-bar.fast { width: 30%; background: var(--accent); animation-delay: 1.6s; }
  @keyframes ring { 0%, 18% { stroke-dashoffset: 0; stroke: #e0624a; } 45%, 90% { stroke-dashoffset: 70; stroke: var(--accent); } 100% { stroke-dashoffset: 0; stroke: #e0624a; } }
  @keyframes swapout { 0%, 22% { opacity: 1; } 34%, 92% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes swapin { 0%, 28% { opacity: 0; } 42%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes barin { 0% { transform: scaleX(0); } 22%, 100% { transform: none; } }

  /* Custom development: a product dashboard filling in */
  .cd { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; }
  .cd-side { display: grid; gap: 0.6rem; align-content: start; justify-items: center; padding: 0.7rem 0; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .cd-side b { width: 20px; height: 20px; border-radius: 6px; background: var(--accent); margin-bottom: 0.3rem; }
  .cd-side i { width: 18px; height: 18px; border-radius: 5px; background: var(--surface-2); }
  .cd-side i.on { outline: 1px solid var(--accent); }
  .cd-main { display: grid; gap: 0.8rem; min-width: 0; }
  .cd-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .cd-tiles span { display: grid; align-content: end; height: 58px; padding: 0.5rem 0.6rem; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .cd-tiles span::before { content: ''; width: 60%; height: 8px; margin-bottom: 0.4rem; border-radius: 4px; background: var(--text); opacity: 0.8; }
  .cd-tiles small { font-size: 0.6875rem; }
  .cd-chart { display: flex; align-items: flex-end; gap: 0.5rem; height: 120px; padding: 0.8rem; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .cd-chart i { flex: 1; height: var(--h); border-radius: 4px 4px 0 0; background: linear-gradient(var(--accent), rgb(var(--accent-rgb) / 0.25)); transform-origin: 50% 100%; animation: bars 9s ease-out infinite; animation-delay: calc(1.4s + var(--k) * 0.12s); }
  .cd-roles { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cd-roles span { padding: 0.2rem 0.7rem; border: 1px solid var(--line); border-radius: 999px; font-size: 0.75rem; color: var(--text); }
  .cd-roles span:first-child { border-color: var(--accent); color: var(--accent-hi); }
  @keyframes bars { 0% { transform: scaleY(0); } 10%, 100% { transform: none; } }

  /* AI: an agent plans, waits for a yes, then acts */
  .ai { display: grid; gap: 0.55rem; }
  .ai p { line-height: 1.45; }
  .ai-you { justify-self: end; max-width: 85%; padding: 0.5rem 0.8rem; border-radius: 12px 12px 2px 12px; background: var(--surface-2); color: var(--text); }
  .ai-plan { color: var(--accent); }
  .ai-plan::before { content: '→ '; }
  .ai-step { color: var(--text); }
  .ai-step::before { content: '○ '; color: var(--muted); }
  .ai-ask { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-top: 0.3rem; padding: 0.55rem 0.6rem 0.55rem 0.9rem; border: 1px solid rgb(var(--accent-rgb) / 0.6); border-radius: 12px; color: var(--text); }
  .ai-ask b { padding: 0.3rem 0.9rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-weight: 600; animation: press 9s ease infinite; }
  .ai-done { color: #9fd8a8; }
  .ai-done::before { content: '✓ '; }
  @keyframes press { 0%, 30%, 40%, 100% { transform: none; box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0.6); } 35% { transform: scale(0.94); box-shadow: 0 0 0 10px rgb(var(--accent-rgb) / 0); } }

  @media (max-width: 860px) {
    .art { justify-self: stretch; max-width: none; }
    .sp { grid-template-columns: 1fr; justify-items: center; }
    .sp-rows { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .art *, .art *::before { animation: none !important; }
    .sp-before { display: none; }
  }
</style>
