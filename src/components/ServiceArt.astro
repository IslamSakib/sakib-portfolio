---
// The picture for each service: its hero image, and the card image under "Other things I do".
// Photos keep their own proportions (nothing is cropped). Decorative, so the alt text is empty; the page text carries the facts.
import { Picture } from 'astro:assets';
import development from '../assets/visuals/build.jpg';
import speed from '../assets/visuals/speed.jpg';
import custom from '../assets/visuals/custom.jpg';

const { slug, eager = false } = Astro.props;
const img = { 'wordpress-development': development, 'wordpress-speed-optimization': speed, 'custom-web-development': custom }[slug] || development;
---
<figure class="art">
  <Picture src={img} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 620px" alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
</figure>

<style>
  .art { margin: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7); }
  .art :global(img) { display: block; width: 100%; height: auto; transition: transform 1.2s var(--ease); }
  .art:hover :global(img) { transform: scale(1.03); }
</style>
