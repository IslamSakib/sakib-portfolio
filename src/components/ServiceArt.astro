---
// The picture for each service: its hero image, and the card image under "Other things I do".
// Photos keep their own proportions (nothing is cropped). Each image shows real client work, so each has its own alt text.
import { Picture } from 'astro:assets';
import website from '../assets/visuals/svc-website.jpg';
import webapp from '../assets/visuals/svc-webapp.jpg';
import wordpress from '../assets/visuals/svc-wordpress.jpg';
import care from '../assets/visuals/svc-care.jpg';
import speed from '../assets/visuals/svc-speed.jpg';
import repair from '../assets/visuals/svc-repair.jpg';
import malware from '../assets/visuals/svc-malware.jpg';

const { slug, eager = false } = Astro.props;
const img = { 'wordpress-development': wordpress, 'wordpress-speed-optimization': speed, 'custom-web-development': website, 'web-application-development': webapp, 'wordpress-repair': repair, 'wordpress-malware-removal': malware, 'wordpress-care-plans': care, 'website-care': care }[slug] || website;
const alt = {
  'wordpress-development': 'Glossy violet blocks with one lifting into place: a WordPress site assembled from custom parts',
  'wordpress-speed-optimization': 'A glowing speed gauge with a lightning bolt: a fast website',
  'web-application-development': 'A large glossy cube linked to smaller cubes: a web application and the parts around it',
  'custom-web-development': 'Three glossy stacked layers from design to backend: a website built as one job',
  'wordpress-repair': 'A glossy violet gear: a broken website repaired at the cause',
  'wordpress-malware-removal': 'A shield checked by a magnifying glass: malware found and removed',
  'website-care': 'A glossy shield with a check mark: a website kept safe and current',
  'wordpress-care-plans': 'A glossy shield with a check mark: a website kept safe and current',
}[slug] || '';
---
<figure class="art">
  <Picture src={img} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 620px" alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
</figure>

<style>
  .art { margin: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7); }
  .art :global(img) { display: block; width: 100%; height: auto; transition: transform 1.2s var(--ease); }
  .art:hover :global(img) { transform: scale(1.03); }
</style>
