---
import { heroLead } from '../heroLead.js';
// One page per ideal customer (see src/icps.js): who it is for, what usually goes wrong, what I do, proof, price and questions.
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.astro';
import ServiceArt from '../components/ServiceArt.astro';
import WorkReel from '../components/WorkReel.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { site } from '../site.js';
import { services } from '../services.js';
import { work } from '../work.js';
import { iconFor } from '../icons.js';
import { icps } from '../icps.js';

const { icp } = Astro.props;
const { focus, title, description, faq } = icp;
const url = new URL(Astro.url.pathname, Astro.site);
const pad = (n) => String(n).padStart(2, '0');
const proof = icp.proof.map((slug) => work.find((w) => w.slug === slug)).filter(Boolean);
const related = icp.services.map((slug) => services.find((s) => s.slug === slug) || (slug === 'website-care' ? { slug, name: 'Website care' } : null)).filter(Boolean);
const others = icps.filter((i) => i.slug !== icp.slug);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: `${site.name}, ${icp.focus}`,
    description,
    url,
    areaServed: ['United States', 'United Kingdom', 'Australia', 'Canada'],
    provider: { '@type': 'Person', name: site.name, url: Astro.site, jobTitle: site.role },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
      { '@type': 'ListItem', position: 2, name: 'Who I help', item: new URL('/for/', Astro.site) },
      { '@type': 'ListItem', position: 3, name: icp.name, item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonld={jsonld} focus={focus} ogImage={`/og-for-${icp.slug}.jpg`} ogAlt={`${title}. Sakib Islam, remote full stack developer.`}>
  <section class="page-head svc-hero">
    <canvas class="dots" aria-hidden="true"></canvas>
    <div class="wrap svc-grid">
      <div class="svc-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/for/">Who I help</a><span>/</span><span>{icp.name}</span>
        </nav>
        <h1>{icp.h1Lines.map((l) => <Fragment><span class="hl">{l}</span>{' '}</Fragment>)}</h1>
        <p class="lead">{heroLead(icp.lead, icp.focus)}</p>
        <div class="hero-actions">
          <a class="btn" href="/contact/?need=build">Get a free quote</a>
          <a class="btn btn-ghost" href="#proof">See the work</a>
        </div>
        <p class="muted">{icp.price}.</p>
      </div>
      <ServiceArt slug={icp.art} eager />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="section-head"><h2>Does this sound like you?</h2></div>
      <ul class="kit kit-2">
        {icp.pains.map((item, i) => (
          <li>
            <span class="kit-top">
              <svg class="kit-ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={iconFor(item.name)} /></svg>
              <span class="idx">{pad(i + 1)}</span>
            </span>
            <h3>{item.name}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec tint-a">
    <div class="wrap">
      <div class="section-head"><h2>What I do for you</h2></div>
      <ul class="kit kit-rows">
        {icp.does.map((item, i) => (
          <li>
            <span class="kit-top">
              <svg class="kit-ico" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={iconFor(item.name)} /></svg>
              <span class="idx">{pad(i + 1)}</span>
            </span>
            <h3>{item.name}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="proof" class="sec">
    <div class="wrap">
      <WorkReel items={proof} title="Projects I've built, with live sites" lead="Pick a project to see the result and the live site." />
    </div>
  </section>

  <section class="sec tint-a">
    <div class="wrap">
      <div class="section-head"><h2>Services for this</h2></div>
      <ul class="kit kit-links">
        {related.map((sv) => (
          <li><h3><a href={`/${sv.slug}/`}>{sv.name}</a></h3></li>
        ))}
        {icp.extra && <li><h3><a href={icp.extra.href}>{icp.extra.label}</a></h3></li>}
      </ul>
    </div>
  </section>

  <Process title="How your project runs, step by step" variant="build" />

  <Reviews />

  <Faq items={faq} title={`Questions from ${icp.name.toLowerCase()}`} />

  <section class="sec">
    <div class="wrap">
      <div class="section-head"><h2>Other people I work with</h2></div>
      <ul class="kit kit-links">
        {others.map((o) => (
          <li><h3><a href={`/for/${o.slug}/`}>{o.name}</a></h3><p class="muted">{o.short}.</p></li>
        ))}
      </ul>
    </div>
  </section>

  <Connect heading="Tell me what you need." />
</Base>

<script>
  import '../scripts/reel.js';
</script>
