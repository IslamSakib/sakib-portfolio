---
// FAQ as two panes: the questions down the left, the chosen answer set large on the right (same reel as Selected work,
// but it never advances by itself). On phones the list is dropped and every question and answer is simply shown in full.
// The page that uses it must load src/scripts/reel.js. The FAQ structured data is written by the page, not here.
import { site } from '../site.js';
const { items, title = 'Questions clients ask' } = Astro.props;
const pad = (n) => String(n).padStart(2, '0');
---
<section id="faq" class="sec band">
  <div class="wrap">
    <div class="faq-top">
      <h2>{title}</h2>
      <a class="btn btn-ghost btn-small" href={site.whatsapp} target="_blank" rel="noopener">Ask something else on WhatsApp</a>
    </div>
    <div class="reel faq-reel" data-reel data-auto="off">
      <div class="reel-list" role="tablist" aria-label="Questions" aria-orientation="vertical">
        {items.map((f, i) => (
          <button type="button" role="tab" id={`faq-tab-${i}`} aria-controls={`faq-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="idx">{pad(i + 1)}</span>
            <span class="name">{f.q}</span>
          </button>
        ))}
      </div>
      <div class="faq-stage" data-reel-stage>
        {items.map((f, i) => (
          <div class:list={['faq-panel', { on: i === 0 }]} role="tabpanel" id={`faq-panel-${i}`} aria-labelledby={`faq-tab-${i}`}>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
