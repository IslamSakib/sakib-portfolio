---
// Pricing cards, shared by the home, maintenance and agency pages. Each card answers, in order: who it is for, what it
// costs and how it is billed, the outcome, exactly what is included (limits stated, never "unlimited"), and one action.
// One card can be marked as the recommended one. Facts only: every line here must also be true on the service pages.
const { plans, compact = false } = Astro.props;
---
<div class:list={['pc-grid', { compact }]} style={`--n:${plans.length}`}>
  {plans.map((p) => (
    <article class:list={['pc', { featured: p.featured }]}>
      {p.featured && <span class="pc-badge">{p.badge || 'Recommended'}</span>}
      <header>
        <p class="pc-name">{p.name}</p>
        <p class="pc-for">{p.for}</p>
      </header>
      <p class="pc-price"><b>{p.price}</b>{p.unit && <small>{p.unit}</small>}</p>
      {p.billing && <p class="pc-billing">{p.billing}</p>}
      {p.outcome && <p class="pc-outcome">{p.outcome}</p>}
      <ul class="pc-list">
        {p.items.map((it) => {
          const item = typeof it === 'string' ? { t: it, ok: true } : it;
          return (
            <li class:list={{ no: item.ok === false }}>
              {item.ok === false
                ? <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 12h12" /></svg>
                : <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>}
              <span>{item.ok === false && <span class="sr-only">Not included: </span>}{item.t}</span>
            </li>
          );
        })}
      </ul>
      <div class="pc-foot">
        <a class:list={['btn', { 'btn-ghost': !p.featured }]} href={p.href}>{p.cta}</a>
        {p.note && <p class="pc-note">{p.note}</p>}
      </div>
    </article>
  ))}
</div>

<style>
  .pc-grid { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1.25rem; align-items: stretch; }
  .pc { position: relative; display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.5rem, 2.4vw, 2.1rem); border: 1px solid var(--line); border-radius: 16px; background: var(--surface); transition: translate 0.6s var(--ease), border-color 0.3s ease, box-shadow 0.6s var(--ease); }
  .pc:hover { translate: 0 -6px; border-color: var(--line-2); box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.9); }
  .pc.featured { border-color: rgb(var(--accent-rgb) / 0.7); background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.12), var(--surface) 45%); box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.25), 0 40px 90px -50px rgb(var(--accent-rgb) / 0.55); }
  .pc-badge { position: absolute; top: -0.8rem; left: clamp(1.5rem, 2.4vw, 2.1rem); padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--accent-fill); color: var(--accent-ink); font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.04em; }
  .pc-name { font-family: var(--display); font-weight: 700; font-size: 1.375rem; letter-spacing: -0.02em; color: var(--text); }
  .pc-for { margin-top: 0.3rem; font-size: 0.9375rem; color: var(--muted); }
  .pc-price { display: flex; align-items: baseline; gap: 0.3rem; padding-top: 0.25rem; }
  .pc-price b { font-family: var(--mono); font-weight: 400; font-size: clamp(2.25rem, 3.6vw, 3rem); letter-spacing: -0.04em; color: var(--text); line-height: 1; }
  .pc-price small { font-family: var(--mono); font-size: 1rem; color: var(--muted); }
  .pc-billing { margin-top: -0.6rem; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); letter-spacing: 0.02em; }
  .pc-outcome { padding-bottom: 1rem; border-bottom: 1px solid var(--line); font-size: 0.9375rem; color: var(--text); }
  .pc-list { display: grid; gap: 0.7rem; }
  .pc-list li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 0.7rem; align-items: start; font-size: 0.9375rem; color: var(--text); }
  .pc-list li svg { margin-top: 0.2rem; fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .pc-list li.no { color: var(--muted); }
  .pc-list li.no svg { stroke: var(--line-2); }
  .pc-foot { margin-top: auto; display: grid; gap: 0.75rem; padding-top: 0.75rem; }
  .pc-foot .btn { width: 100%; }
  .pc-note { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); text-align: center; }
  .compact .pc-outcome { display: none; }
  .compact .pc-list { gap: 0.55rem; }
  @media (max-width: 1100px) { .pc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .pc-grid { grid-template-columns: minmax(0, 1fr); row-gap: 1.75rem; } }
  @media (hover: none) { .pc:hover { translate: none; box-shadow: none; } }
</style>
