---
// Free audit request: a small agent-style console. The visitor gives a site address, watches the audit plan being laid out,
// answers one question and leaves a contact. The request is emailed to Sakib by /lead.php with the subject "Free Audit request".
// Nothing here pretends to have tested the site: the steps shown are the plan, and they say so.
import { site } from '../site.js';
---
<section id="audit" class="sec band band-grid audit">
  <div class="wrap audit-grid">
    <div class="audit-copy" data-reveal>
      <p class="label">Free audit</p>
      <h2>Get a free audit of your site</h2>
      <p class="lead">Give me the address. I look at it myself and send back what is slowing it down or breaking it, and the three fixes I would do first.</p>
      <ul>
        <li>Mobile speed and Core Web Vitals, measured with Google's own tool</li>
        <li>Plugins, theme and caching: what is clashing or doing nothing</li>
        <li>What is stopping search engines reading the site</li>
      </ul>
      <p class="muted small">No cost and no obligation. You get the findings whether or not we work together.</p>
    </div>
    <div class="console" data-audit data-whatsapp={site.whatsapp} data-reveal style="--d:0.12s">
      <div class="console-bar"><i></i><i></i><i></i><span>audit-agent</span><b data-audit-state>ready</b></div>
      <div class="console-log" aria-live="polite">
        <p class="line sys">Paste your site address and I will lay out the audit.</p>
      </div>
      <div class="console-chips"></div>
      <form autocomplete="off" novalidate>
        <input class="chat-trap" type="text" name="company" tabindex="-1" aria-hidden="true" />
        <label class="chat-sr" for="audit-input">Your website address</label>
        <span class="prompt" aria-hidden="true">&gt;</span>
        <input id="audit-input" type="text" name="value" placeholder="yoursite.com" maxlength="200" inputmode="url" enterkeyhint="go" />
        <button class="btn btn-small" type="submit">Start</button>
      </form>
    </div>
  </div>
</section>

<script>
  import '../scripts/audit.js';
</script>
