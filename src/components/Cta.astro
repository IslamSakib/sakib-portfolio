---
// The closing "Start a project" band, shared by the home page, service pages and case studies.
import { site } from '../site.js';
import { socials } from '../socials.js';

const { heading = 'Have a site to build, speed up or fix?' } = Astro.props;
const pad = (n) => String(n).padStart(2, '0');

// Quick starts that open WhatsApp with a message begun, and what follows a first message.
const picks = [
  { label: 'Build a new site', text: 'Hi Sakib, I need a new website built. Here is what it is for: ' },
  { label: 'Speed up a slow site', text: 'Hi Sakib, my site is slow and I want it faster. The address is: ' },
  { label: 'Fix a broken site', text: 'Hi Sakib, my site has a problem I need fixed. The address is: ' },
  { label: 'Add AI to my product', text: 'Hi Sakib, I want to add AI to my product or site. Here is what I have in mind: ' },
];
const nextSteps = [
  { name: 'You send the details', text: 'The site address, or the idea, and what is going wrong.' },
  { name: 'I look before I quote', text: 'I check the site and tell you what I would look at first.' },
  { name: 'We agree the scope', text: 'What gets done, in what order, and how the result is measured.' },
];
---
<section id="contact" class="sec cta">
  <canvas class="dots" aria-hidden="true"></canvas>
  <div class="wrap cta-grid">
    <div class="cta-copy" data-reveal>
      <h2>{heading}</h2>
      <p class="lead">Tell me what it is and what is going wrong. I reply with what I would check first, before you spend anything.</p>
      <div class="picks">
        <p>Pick one and WhatsApp opens with the message started:</p>
        <ul>
          {picks.map((pick) => (
            <li>
              <a href={`${site.whatsapp}?text=${encodeURIComponent(pick.text)}`} target="_blank" rel="noopener">
                {pick.label}<span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero-actions">
        <button class="btn" type="button" data-chat-open>Tell me about your project</button>
        {socials.slice(0, 2).map((s) => (
          <a class="btn btn-ghost" href={s.url} target="_blank" rel="noopener">
            <svg class="ico" viewBox={`0 0 ${s.box} ${s.box}`} width="18" height="18" aria-hidden="true"><path d={s.path} /></svg>
            {s.name}
          </a>
        ))}
      </div>
    </div>
    <aside class="cta-card" data-spot data-reveal style="--d:0.12s" aria-label="What happens next">
      <p class="label">What happens next</p>
      <ol class="next-steps">
        {nextSteps.map((step, i) => (
          <li>
            <span class="idx">{pad(i + 1)}</span>
            <div>
              <h3>{step.name}</h3>
              <p class="muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <dl class="reach">
        <div><dt>WhatsApp</dt><dd><a href={site.whatsapp} target="_blank" rel="noopener">+880 1950 025990</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={site.linkedin} target="_blank" rel="noopener">in/sakibislamofficial</a></dd></div>
        <div><dt>Dhaka time</dt><dd data-clock>GMT+6</dd></div>
      </dl>
    </aside>
  </div>
</section>
