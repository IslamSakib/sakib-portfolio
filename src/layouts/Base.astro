---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import fontUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import { site } from '../site.js';
import { socials } from '../socials.js';

const { title, description, jsonld = [], ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#191817" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="word">Sakib <b>Islam</b><i aria-hidden="true">.</i></span>
        </a>
        <nav aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/#services">Services</a>
          <a href="/#reviews">Reviews</a>
          <a href="/#faq">FAQ</a>
          <a class="btn btn-small" href="/#contact">Start a project</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span class="bigmark" aria-hidden="true">Sakib Islam<i>.</i></span>
      <div class="wrap foot">
        <p>
          {site.name}, {site.role} in {site.location}. Founder of{' '}<a href={site.wrkbase} target="_blank" rel="noopener">Wrkbase</a>.
        </p>
        <p class="foot-links">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><svg class="ico" viewBox={`0 0 ${s.box} ${s.box}`} width="18" height="18" aria-hidden="true"><path d={s.path} /></svg></a>
          ))}
        </p>
      </div>
    </footer>
    <script is:inline>
      // All motion that needs script: scroll reveals, number tickers, typed headings, the cursor glow and spotlight,
      // magnetic buttons, the tilting portrait, the hero dot field and the Dhaka clock. Skipped under reduced motion.
      (() => {
        const clocks = document.querySelectorAll('[data-clock]');
        if (clocks.length) {
          const show = () => {
            const now = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dhaka' }).format(new Date()) + ' local';
            clocks.forEach((c) => { c.textContent = now; });
          };
          show(); setInterval(show, 30000);
        }
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js');
        const tick = (el) => {
          const end = +el.dataset.count, dec = +(el.dataset.dec || 0), t0 = performance.now();
          const step = (t) => {
            const k = Math.min((t - t0) / 1100, 1);
            el.textContent = (end * (1 - Math.pow(1 - k, 3))).toFixed(dec);
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        // Section headings type themselves out. The height is reserved first so nothing below moves.
        const type = (el) => {
          const text = el.textContent.trim(), gap = Math.min(32, 1100 / text.length);
          el.style.minHeight = el.offsetHeight + 'px';
          el.setAttribute('aria-label', text);
          el.textContent = '';
          el.classList.add('typing');
          let i = 0;
          const next = () => {
            el.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(next, gap);
            else setTimeout(() => el.classList.remove('typing'), 1400);
          };
          next();
        };
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (e.target.dataset.count) tick(e.target);
          if (e.target.tagName === 'H2') type(e.target);
          io.unobserve(e.target);
        }), { threshold: 0.15 });
        document.querySelectorAll('[data-reveal], [data-count], main h2').forEach((el) => io.observe(el));

        // Dot fields (hero and contact): a slow wave runs through each, and dots near the cursor light up and move away from it.
        // Each canvas only draws while it is on screen.
        const fields = [...document.querySelectorAll('.dots')].map((cv) => {
          const ctx = cv.getContext('2d'), gap = 26, f = { cv, mx: -999, my: -999 };
          let w = 0, h = 0, on = false;
          const size = () => {
            const d = Math.min(devicePixelRatio || 1, 2);
            w = cv.clientWidth; h = cv.clientHeight;
            cv.width = w * d; cv.height = h * d;
            ctx.setTransform(d, 0, 0, d, 0, 0);
          };
          const draw = (t) => {
            ctx.clearRect(0, 0, w, h);
            for (let y = gap / 2; y < h; y += gap) for (let x = gap / 2; x < w; x += gap) {
              const dx = x - f.mx, dy = y - f.my, near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 190);
              if (near > 0.02) {
                const a = Math.atan2(dy, dx), push = near * near * 14;
                ctx.fillStyle = 'rgba(255,133,82,' + (0.2 + near * 0.8) + ')';
                ctx.beginPath(); ctx.arc(x + Math.cos(a) * push, y + Math.sin(a) * push, 1 + near * 1.8, 0, 6.2832); ctx.fill();
              } else {
                ctx.fillStyle = 'rgba(245,244,239,' + (0.05 + 0.1 * (0.5 + 0.5 * Math.sin(x * 0.011 + y * 0.017 - t * 0.0011))) + ')';
                ctx.fillRect(x - 1, y - 1, 2, 2);
              }
            }
            if (on) requestAnimationFrame(draw);
          };
          size(); addEventListener('resize', size);
          new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) requestAnimationFrame(draw); }).observe(cv);
          return f;
        });

        if (matchMedia('(hover: hover)').matches) {
          addEventListener('pointermove', (e) => {
            document.documentElement.style.setProperty('--gx', e.clientX + 'px');
            document.documentElement.style.setProperty('--gy', e.clientY + 'px');
            fields.forEach((f) => { const r = f.cv.getBoundingClientRect(); f.mx = e.clientX - r.left; f.my = e.clientY - r.top; });
          }, { passive: true });
          document.querySelectorAll('[data-spot]').forEach((el) => el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', e.clientX - r.left + 'px');
            el.style.setProperty('--my', e.clientY - r.top + 'px');
          }));
          document.querySelectorAll('[data-magnet]').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.transform = 'translate(' + (e.clientX - r.left - r.width / 2) * 0.28 + 'px,' + (e.clientY - r.top - r.height / 2) * 0.4 + 'px)';
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
          document.querySelectorAll('[data-tilt]').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect(), px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
              el.style.transform = 'perspective(900px) rotateY(' + px * 14 + 'deg) rotateX(' + -py * 14 + 'deg) scale(1.03)';
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
        }
      })();
    </script>
  </body>
</html>
