---
import fontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import fontExtUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-ext-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import monoExtUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-ext-wght-normal.woff2?url';
import displayUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import displayExtUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/pages.css';
import { site } from '../site.js';
import { prices, usd } from '../prices.js';
import { icps } from '../icps.js';
import { socials } from '../socials.js';
import { designedOg } from '../ogDesigned.js';
import { Image } from 'astro:assets';
import Clock from '../components/Clock.astro';
import megaVisual from '../assets/visuals/mayabee.jpg';

const { title, description, jsonld = [], ogImage: ogDefault = '/og.png', ogAlt = `${site.name}, ${site.role}`, focus } = Astro.props;
// Share images are cached for a long time by LinkedIn and others: raise `v` whenever scripts/og.mjs output changes.
const ogImage = designedOg[Astro.url.pathname] ?? ogDefault;
const ogUrl = `${new URL(ogImage, Astro.site)}?v=4`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The services menu names the job in the visitor's words, not the page's search keyword. `ic` is an icon path drawn in
// a 24-unit box; `price` is the starting price shown on the card.
const menu = [
  { slug: 'custom-web-development', name: 'Custom website development', short: 'Websites and online stores: UI/UX, frontend, backend, dashboard.', price: `from ${usd(prices.site)}`, ic: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16' },
  { slug: 'web-application-development', name: 'Web application development', short: 'Portals, internal tools and SaaS: sign-in, roles, dashboards, APIs.', price: `from ${usd(prices.webApp)}`, ic: 'M3 4h18v14H3zM3 9h18M7 6.5h.01M10 6.5h.01M8 13h8' },
  { slug: 'wordpress-development', name: 'WordPress development', short: 'Custom themes, plugins, WooCommerce and payments.', price: `from ${usd(prices.build)}`, ic: 'M3 4h18v12H3zM8 20h8M12 16v4' },
  { slug: 'website-care', name: 'Website care', short: 'Monthly updates, backups, monitoring and fixes.', price: `${usd(prices.care)}/mo`, ic: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4' },
  { slug: 'wordpress-repair', name: 'Website repair and speed fixes', short: 'A broken or slow website fixed at the cause.', price: `from ${usd(prices.fix)}`, ic: 'M13 2L4 14h7l-1 8 9-12h-7z' },
  { slug: 'white-label-wordpress-development', name: 'White-label WordPress for agencies', short: 'Your design built in WordPress, under your name.', price: `${usd(prices.agencyHour)}/h`, ic: 'M4 7h16v12H4zM9 7V5h6v2' },
];
const businessMenu = menu.slice(0, 4);
const agencyMenu = menu[menu.length - 1];
// Text links under the service cards: hire by role, and fixing or caring for a live website.
const hireLinks = [
  { href: '/full-stack-developer/', t: 'Hire a full stack developer' },
  { href: '/web-application-developer/', t: 'Hire a web application developer' },
  { href: '/wordpress-developer/', t: 'Hire a WordPress developer' },
];
const fixLinks = [
  { href: '/wordpress-care-plans/', t: 'Compare care plans' },
  { href: '/wordpress-malware-removal/', t: 'Clean a hacked website' },
  { href: '/blog/', t: 'Guides and costs' },
];
const audienceLinks = icps.map((i) => ({ href: `/for/${i.slug}/`, t: i.name }));
const agencyGuides = [
  { href: '/white-label-wordpress-maintenance/', t: 'White-label support and care' },
  { href: '/blog/choosing-a-white-label-wordpress-partner/', t: 'Choosing a white label partner' },
  { href: '/blog/outsource-wordpress-development/', t: 'Outsourcing WordPress builds' },
  { href: '/blog/white-label-wordpress-maintenance/', t: 'Reselling care plans' },
];
---
<!doctype html>
<html lang="en" data-focus={focus}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="max-image-preview:large" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <!-- All three fonts are declared here (not via their packages, which also ship unused Cyrillic, Greek and Vietnamese
         faces) with font-display: block, so headings wait
         briefly for the preloaded file instead of drawing in a fallback that wraps differently and then shifts. -->
    <style is:inline set:html={`@font-face{font-family:'Bricolage Grotesque Variable';font-style:normal;font-display:block;font-weight:200 800;src:url(${displayUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Bricolage Grotesque Variable';font-style:normal;font-display:block;font-weight:200 800;src:url(${displayExtUrl}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:'Hanken Grotesk Variable';font-style:normal;font-display:block;font-weight:100 900;src:url(${fontUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Hanken Grotesk Variable';font-style:normal;font-display:block;font-weight:100 900;src:url(${fontExtUrl}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:'Geist Mono Variable';font-style:normal;font-display:block;font-weight:100 900;src:url(${monoUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Geist Mono Variable';font-style:normal;font-display:block;font-weight:100 900;src:url(${monoExtUrl}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0a0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="author" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="word">Sakib <b>Islam</b><i aria-hidden="true">.</i></span>
        </a>
        <nav aria-label="Main">
          <div class="has-menu">
            <a href="/#services" aria-haspopup="true">Services <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <div class="menu mega">
              <div class="mega-col mega-biz">
                <p class="mega-label">For businesses</p>
                <div class="mega-grid">
                  {businessMenu.map((sv) => (
                    <a class="mega-item" href={`/${sv.slug}/`}>
                      <span class="mega-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d={sv.ic} /></svg></span>
                      <span class="mega-text"><b>{sv.name}</b><small>{sv.short}</small><em>{sv.price}</em></span>
                    </a>
                  ))}
                </div>
                <div class="mega-groups">
                  <div class="mega-wide">
                    <p class="mega-sub">Fix and care</p>
                    <ul class="mega-links mega-care mega-cols">
                      <li><a href="/wordpress-repair/">Website repair and speed fixes <span aria-hidden="true">→</span></a></li>
                      {fixLinks.map((g) => <li><a href={g.href}>{g.t} <span aria-hidden="true">→</span></a></li>)}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="mega-col mega-agency">
                <p class="mega-label">For agencies</p>
                <a class="mega-item" href={`/${agencyMenu.slug}/`}>
                  <span class="mega-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d={agencyMenu.ic} /></svg></span>
                  <span class="mega-text"><b>{agencyMenu.name}</b><small>{agencyMenu.short}</small><em>{agencyMenu.price} · from {usd(prices.agencySite)} a site</em></span>
                </a>
                <p class="mega-sub">Also for agencies</p>
                <ul class="mega-links">
                  {agencyGuides.map((g) => <li><a href={g.href}>{g.t} <span aria-hidden="true">→</span></a></li>)}
                </ul>
              </div>
              <a class="mega-feature" href="/contact/">
                <Image src={megaVisual} widths={[320, 480]} sizes="280px" alt="Mayabee, an online shop built from scratch, with the admin dashboard built for it" loading="lazy" />
                <span class="mega-feature-text"><b>Not sure where to start?</b><small>Send your site URL or project requirements. I reply within 24 hours with clear pricing.</small><span class="mega-cta">Get a free quote <span aria-hidden="true">→</span></span></span>
              </a>
            </div>
          </div>
          <div class="has-menu">
            <a href="/for/" aria-haspopup="true">Who I help <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <div class="menu mega">
              <div class="mega-col">
                <p class="mega-label">Who I help</p>
                <ul class="mega-links mega-care mega-cols">
                  {audienceLinks.map((g) => <li><a href={g.href}>{g.t} <span aria-hidden="true">→</span></a></li>)}
                </ul>
              </div>
              <div class="mega-col mega-agency">
                <p class="mega-label">Hire by role</p>
                <ul class="mega-links mega-care">
                  {hireLinks.map((g) => <li><a href={g.href}>{g.t} <span aria-hidden="true">→</span></a></li>)}
                </ul>
              </div>
              <a class="mega-feature" href="/for/">
                <Image src={megaVisual} widths={[320, 480]} sizes="280px" alt="Mayabee, an online shop built from scratch, with the admin dashboard built for it" loading="lazy" />
                <span class="mega-feature-text"><b>Not sure which fits?</b><small>Tell me about your business. I reply within 24 hours with clear pricing.</small><span class="mega-cta">See all audiences <span aria-hidden="true">→</span></span></span>
              </a>
            </div>
          </div>
          <a href="/white-label-wordpress-development/">For agencies</a>
          <a href="/#work">Client work</a>
          <a href="/#about">About</a>
          <a href="/blog/">Blog</a>
          <a class="btn btn-small" href="/contact/">Get a free quote</a>
          <details class="mnav">
            <summary aria-label="Menu"><span class="mnav-open">Menu</span><span class="mnav-close">Close</span><i aria-hidden="true"></i></summary>
            <div class="mnav-panel">
              <div class="mnav-main">
                {[['For agencies', '/white-label-wordpress-development/'], ['Client work', '/#work'], ['About', '/#about'], ['Blog', '/blog/'], ['Contact', '/contact/']].map(([label, href], i) => (
                  <a href={href} style={`--i:${i}`}>{label}</a>
                ))}
              </div>
              <p class="mnav-label" style="--i:5">How I can help</p>
              <div class="mnav-svc">
                {menu.map((sv, i) => <a href={`/${sv.slug}/`} style={`--i:${i + 6}`}><span>{String(i + 1).padStart(2, '0')}</span>{sv.name}</a>)}
                {[...hireLinks, ...fixLinks].map((g, i) => <a href={g.href} style={`--i:${i + 12}`}><span>{String(menu.length + i + 1).padStart(2, '0')}</span>{g.t}</a>)}
              </div>
              <p class="mnav-label" style="--i:18">Who I help</p>
              <div class="mnav-svc">
                {audienceLinks.map((g, i) => <a href={g.href} style={`--i:${i + 19}`}><span>{String(i + 1).padStart(2, '0')}</span>{g.t}</a>)}
              </div>
              <div class="mnav-foot" style="--i:27">
                <a class="btn" href="/contact/">Get a free quote</a>
                <p><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp +880 1950 025990</a></p>
              </div>
            </div>
          </details>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <!-- The wordmark as an outline, drawn in SVG so the stroke stays crisp at any size. A short bright dash runs along it. -->
      <svg class="bigmark" viewBox="0 0 1200 236" aria-hidden="true" focusable="false">
        <text x="600" y="186" text-anchor="middle" textLength="1110" lengthAdjust="spacingAndGlyphs">Sakib Islam.</text>
        <text class="run" x="600" y="186" text-anchor="middle" textLength="1110" lengthAdjust="spacingAndGlyphs">Sakib Islam.</text>
      </svg>
      <div class="wrap foot">
        <p>
          {site.name}, {site.role} in {site.location}. Founder of{' '}<a href={site.wrkbase} target="_blank" rel="noopener">Wrkbase</a>.<br /><a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a>
        </p>
        <Clock compact />
        <p class="foot-links">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><svg class="ico" viewBox={`0 0 ${s.box} ${s.box}`} width="18" height="18" aria-hidden="true"><path d={s.path} /></svg></a>
          ))}
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" data-top aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="chat" data-chat data-whatsapp={site.whatsapp}>
      <div class="chat-panel" role="dialog" aria-label="Project chat with Sakib's assistant" hidden>
        <header>
          <div>
            <strong>Sakib's assistant</strong>
            <span>Automated. Your answers go straight to Sakib.</span>
          </div>
          <button class="chat-close" type="button" aria-label="Close chat">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </header>
        <div class="chat-log" aria-live="polite"></div>
        <div class="chat-chips"></div>
        <form autocomplete="off">
          <input class="chat-trap" type="text" name="company" tabindex="-1" aria-hidden="true" />
          <label class="chat-sr" for="chat-msg">Your message</label>
          <input id="chat-msg" type="text" name="msg" placeholder="Type your answer" maxlength="600" enterkeyhint="send" />
          <button type="submit" aria-label="Send">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </form>
      </div>
      <button class="chat-launcher" type="button" aria-expanded="false" aria-label="Open project chat">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
      </button>
    </div>
    <script>
      import '../scripts/chat.js';
    </script>
    <script is:inline>
      // Small page behaviours: the Dhaka clock, the click and hover sounds and the hero dot fields. Nothing animates in on load or scroll.
      // Skipped under reduced motion.
      (() => {
        // Clock: Dhaka time (UTC+6, no daylight saving) to the second, and on the full version the visitor's own time and
        // the gap, so nobody has to work out the time difference. Updates once a second; a hidden tab is not redrawn.
        const clocks = document.querySelectorAll('[data-clock]');
        if (clocks.length) {
          const fmt = (tz) => new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23', ...(tz && { timeZone: tz }) });
          const dhaka = fmt('Asia/Dhaka'), mine = fmt(), mineShort = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
          const gap = () => {
            const d = new Date();
            const dhakaMin = (d.getUTCHours() * 60 + d.getUTCMinutes() + 360) % 1440;
            const hereMin = d.getHours() * 60 + d.getMinutes();
            let diff = dhakaMin - hereMin; if (diff > 720) diff -= 1440; if (diff < -720) diff += 1440;
            if (!diff) return 'same time as you';
            const h = Math.floor(Math.abs(diff) / 60), m = Math.abs(diff) % 60;
            return `${[h && `${h}h`, m && `${m}m`].filter(Boolean).join(' ')} ${diff > 0 ? 'ahead of' : 'behind'} you`;
          };
          const show = () => {
            if (document.hidden) return;
            const d = new Date(), t = dhaka.format(d);
            clocks.forEach((c) => {
              const el = c.querySelector('[data-clock-time]'); if (el) { el.textContent = t; el.dateTime = t; }
              const you = c.querySelector('[data-clock-you]'); if (you) you.textContent = `Your time ${mineShort.format(d)} · Dhaka is ${gap()}`;
            });
          };
          show(); setInterval(show, 1000); document.addEventListener('visibilitychange', show);
        }
        // Sound: a soft tick when a link, button or other control is clicked, made with Web Audio (no audio file).
        // `click` rather than `pointerdown`, so touching the screen to scroll, or tapping blank space, stays silent.
        let audio;
        const ctx = () => {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          audio = audio || new AC();
          if (audio.state === 'suspended') audio.resume();
          return audio;
        };
        const tick = (freq) => {
          if (!ctx()) return;
          const o = audio.createOscillator(), g = audio.createGain(), t = audio.currentTime;
          o.type = 'sine';
          o.frequency.setValueAtTime(freq, t);
          o.frequency.exponentialRampToValueAtTime(freq * 0.55, t + 0.09);
          g.gain.setValueAtTime(0.0001, t);
          g.gain.exponentialRampToValueAtTime(0.06, t + 0.008);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 0.11);
          o.connect(g).connect(audio.destination);
          o.start(t); o.stop(t + 0.12);
        };
        addEventListener('click', (e) => {
          if (e.target.closest?.('a[href], button, summary, label, select, input:not([type=text], [type=email], [type=tel], [type=url]), [role=button]')) tick(880);
        }, { passive: true });
        // Hover sound for buttons: a soft rising swish that lasts as long as the button's fill rising (0.4 s).
        // Only on screens with a real pointer, and only once the visitor has interacted (browsers keep sound off before that).
        if (matchMedia('(hover: hover)').matches) {
          let air = null;
          const swish = () => {
            if (!(navigator.userActivation ? navigator.userActivation.hasBeenActive : audio) || !ctx()) return;
            if (!air) {
              air = audio.createBuffer(1, Math.floor(audio.sampleRate * 0.5), audio.sampleRate);
              const d = air.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
            }
            const t = audio.currentTime, n = audio.createBufferSource(), f = audio.createBiquadFilter(), g = audio.createGain();
            n.buffer = air; f.type = 'bandpass'; f.Q.value = 1.4;
            f.frequency.setValueAtTime(500, t); f.frequency.exponentialRampToValueAtTime(2600, t + 0.38);
            g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.03, t + 0.12); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
            n.connect(f).connect(g).connect(audio.destination); n.start(t); n.stop(t + 0.42);
            const o = audio.createOscillator(), h = audio.createGain();
            o.type = 'sine'; o.frequency.setValueAtTime(660, t); o.frequency.exponentialRampToValueAtTime(990, t + 0.35);
            h.gain.setValueAtTime(0.0001, t); h.gain.exponentialRampToValueAtTime(0.012, t + 0.1); h.gain.exponentialRampToValueAtTime(0.0001, t + 0.38);
            o.connect(h).connect(audio.destination); o.start(t); o.stop(t + 0.4);
          };
          addEventListener('pointerover', (e) => {
            const b = e.target.closest && e.target.closest('.btn');
            if (b && !(e.relatedTarget && b.contains(e.relatedTarget))) swish();
          }, { passive: true });
        }
        // Silence when the tab is in the background.
        document.addEventListener('visibilitychange', () => { if (audio) document.hidden ? audio.suspend() : audio.resume(); });

        // Ambient motion (no entrance animations): the hero dot fields. Skipped for visitors who prefer reduced motion.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        // Dot fields: each canvas draws a grid of dots with a slow wave through it. Dots near the pointer turn the
        // accent colour, grow and lean away. A field only draws while it is on screen, and fades out towards its edges.
        const fields = [...document.querySelectorAll('.dots')].map((cv) => {
          const g = cv.getContext('2d'), gap = 28, f = { cv, mx: -999, my: -999 };
          let w = 0, h = 0, on = false;
          const size = () => {
            const d = Math.min(devicePixelRatio || 1, 2);
            w = cv.clientWidth; h = cv.clientHeight;
            cv.width = w * d; cv.height = h * d;
            g.setTransform(d, 0, 0, d, 0, 0);
          };
          const draw = (t) => {
            g.clearRect(0, 0, w, h);
            for (let y = gap / 2; y < h; y += gap) {
              const edge = Math.max(0, Math.min(1, y / 90, (h - y) / 150));
              for (let x = gap / 2; x < w; x += gap) {
                const dx = x - f.mx, dy = y - f.my, near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 200);
                if (near > 0.02) {
                  const a = Math.atan2(dy, dx), push = near * near * 16;
                  g.fillStyle = 'rgba(167,139,250,' + (0.25 + near * 0.75) * edge + ')';
                  g.beginPath(); g.arc(x + Math.cos(a) * push, y + Math.sin(a) * push, 1 + near * 2, 0, 6.2832); g.fill();
                } else {
                  g.fillStyle = 'rgba(239,234,246,' + (0.04 + 0.09 * (0.5 + 0.5 * Math.sin(x * 0.011 + y * 0.017 - t * 0.0011))) * edge + ')';
                  g.fillRect(x - 1, y - 1, 2, 2);
                }
              }
            }
            if (on) requestAnimationFrame(draw);
          };
          size(); addEventListener('resize', size);
          new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) requestAnimationFrame(draw); }).observe(cv);
          return f;
        });

        if (matchMedia('(hover: hover)').matches) {
          addEventListener('pointermove', (e) => {
            fields.forEach((f) => { const r = f.cv.getBoundingClientRect(); f.mx = e.clientX - r.left; f.my = e.clientY - r.top; });
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
