---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/geist-mono';
import fontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import displayUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/pages.css';
import { site } from '../site.js';
import { socials } from '../socials.js';
import { services } from '../services.js';

const { title, description, jsonld = [], ogImage = '/og.png', ogAlt = `${site.name}, ${site.role}`, focus } = Astro.props;
// Share images are cached for a long time by LinkedIn and others: raise `v` whenever scripts/og.mjs output changes.
const ogUrl = `${new URL(ogImage, Astro.site)}?v=2`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Services menu: the maintenance page has its own layout, so it is listed here rather than in services.js.
const menu = [{ slug: 'wordpress-maintenance', name: 'Maintenance and fixes', short: 'Care plans from $149 a month, or one problem fixed.' }, ...services];
---
<!doctype html>
<html lang="en" data-focus={focus}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0a0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="author" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="word">Sakib <b>Islam</b><i aria-hidden="true">.</i></span>
        </a>
        <nav aria-label="Main">
          <div class="has-menu">
            <a href="/#services" aria-haspopup="true">Services <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <div class="menu">
              {menu.map((sv, i) => (
                <a href={`/${sv.slug}/`}>
                  <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                  <span><b>{sv.name}</b><small>{sv.short}</small></span>
                </a>
              ))}
              <a class="menu-foot" href="/contact/">Not sure which one? Get a free site check</a>
            </div>
          </div>
          <a href="/white-label-wordpress-development/">For agencies</a>
          <a href="/#work">Work</a>
          <a href="/#about">About</a>
          <a href="/blog/">Blog</a>
          <a class="btn btn-small" href="/contact/">Get a free site check</a>
          <details class="mnav">
            <summary>Menu</summary>
            <div class="mnav-panel">
              {menu.map((sv) => <a href={`/${sv.slug}/`}>{sv.name}</a>)}
              <a href="/white-label-wordpress-development/">For agencies</a>
              <a href="/#work">Work</a>
              <a href="/#about">About</a>
              <a href="/blog/">Blog</a>
              <a href="/contact/">Contact</a>
            </div>
          </details>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <!-- The wordmark as an outline, drawn in SVG so the stroke stays crisp at any size. A short bright dash runs along it. -->
      <svg class="bigmark" viewBox="0 0 1200 236" aria-hidden="true" focusable="false">
        <text x="600" y="186" text-anchor="middle" textLength="1110" lengthAdjust="spacingAndGlyphs">Sakib Islam.</text>
        <text class="run" x="600" y="186" text-anchor="middle" textLength="1110" lengthAdjust="spacingAndGlyphs">Sakib Islam.</text>
      </svg>
      <div class="wrap foot">
        <p>
          {site.name}, {site.role} in {site.location}. Founder of{' '}<a href={site.wrkbase} target="_blank" rel="noopener">Wrkbase</a>.
        </p>
        <p class="foot-links">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><svg class="ico" viewBox={`0 0 ${s.box} ${s.box}`} width="18" height="18" aria-hidden="true"><path d={s.path} /></svg></a>
          ))}
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" data-top aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="chat" data-chat data-whatsapp={site.whatsapp}>
      <div class="chat-panel" role="dialog" aria-label="Project chat with Sakib's assistant" hidden>
        <header>
          <div>
            <strong>Sakib's assistant</strong>
            <span>Automated. Your answers go straight to Sakib.</span>
          </div>
          <button class="chat-close" type="button" aria-label="Close chat">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </header>
        <div class="chat-log" aria-live="polite"></div>
        <div class="chat-chips"></div>
        <form autocomplete="off">
          <input class="chat-trap" type="text" name="company" tabindex="-1" aria-hidden="true" />
          <label class="chat-sr" for="chat-msg">Your message</label>
          <input id="chat-msg" type="text" name="msg" placeholder="Type your answer" maxlength="600" enterkeyhint="send" />
          <button type="submit" aria-label="Send">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </form>
      </div>
      <button class="chat-launcher" type="button" aria-expanded="false" aria-label="Open project chat">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
      </button>
    </div>
    <script>
      import '../scripts/chat.js';
    </script>
    <script is:inline>
      // All motion that needs script: number tickers, typed headings, the dot fields, the tilting portrait and the Dhaka clock.
      // Skipped under reduced motion.
      (() => {
        const clocks = document.querySelectorAll('[data-clock]');
        if (clocks.length) {
          const show = () => {
            const now = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dhaka' }).format(new Date()) + ' local';
            clocks.forEach((c) => { c.textContent = now; });
          };
          show(); setInterval(show, 30000);
        }
        // Sound: a soft tick on every click and a continuous, quiet generated music bed, both made with Web Audio (no audio files).
        // Browsers only allow sound after the visitor's first click, tap or key press, so the music is set up on arrival and becomes
        // audible at that first interaction (or at once, where the browser already allows sound for this site). No off switch, by request.
        let audio, music = null;
        const ctx = () => {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          audio = audio || new AC();
          if (audio.state === 'suspended') audio.resume();
          return audio;
        };
        const tick = (freq) => {
          if (!ctx()) return;
          const o = audio.createOscillator(), g = audio.createGain(), t = audio.currentTime;
          o.type = 'sine';
          o.frequency.setValueAtTime(freq, t);
          o.frequency.exponentialRampToValueAtTime(freq * 0.55, t + 0.09);
          g.gain.setValueAtTime(0.0001, t);
          g.gain.exponentialRampToValueAtTime(0.06, t + 0.008);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 0.11);
          o.connect(g).connect(audio.destination);
          o.start(t); o.stop(t + 0.12);
        };
        // Music: a slow, calm ambient bed. A warm descending loop of consonant chords (F major 9, E minor 7, D minor 9,
        // C major 9) as soft pads that swell in and overlap, so there is never a gap; a soft, round bass; and a sparse
        // melody that only uses notes that fit every chord (C, D, E, G, A), so nothing clashes. Long gentle reverb, no drums.
        // Notes are scheduled ahead on the audio clock so it never drops out, and it carries on from page to page,
        // picking up at the same place in the tune.
        const chords = [
          { bass: 87.31, keys: [261.63, 329.63, 392.0, 440.0] },
          { bass: 82.41, keys: [246.94, 293.66, 329.63, 392.0] },
          { bass: 73.42, keys: [220.0, 261.63, 349.23, 440.0] },
          { bass: 65.41, keys: [246.94, 293.66, 329.63, 392.0] },
        ];
        // The melody over the 32 steps (four chords of eight); 0 is a rest. Few notes, long and soft.
        const melody = [
          659.25, 0, 0, 783.99, 0, 0, 0, 0,
          587.33, 0, 0, 659.25, 0, 783.99, 0, 0,
          523.25, 0, 0, 440.0, 0, 0, 0, 0,
          659.25, 0, 0, 587.33, 0, 0, 523.25, 0,
        ];
        const startMusic = () => {
          if (music || !ctx()) return;
          try { sessionStorage.setItem('music', 'on'); } catch (e) {}
          const out = audio.createGain(), warm = audio.createBiquadFilter();
          // Where the last page left off, if there was one: the step it had reached and when.
          let saved = null;
          try { saved = JSON.parse(sessionStorage.getItem('music-at')); } catch (e) {}
          out.gain.setValueAtTime(0.0001, audio.currentTime);
          out.gain.exponentialRampToValueAtTime(0.8, audio.currentTime + (saved ? 0.5 : 4));
          warm.type = 'lowpass'; warm.frequency.value = 2200; warm.Q.value = 0.1;
          warm.connect(out).connect(audio.destination);
          const beat = 60 / 56 / 2;
          // Reverb: a 3.5 second tail made from decaying noise, mixed in quietly.
          const verb = audio.createConvolver(), wet = audio.createGain();
          const len = Math.floor(audio.sampleRate * 3.5), ir = audio.createBuffer(2, len, audio.sampleRate);
          for (let c = 0; c < 2; c++) { const d = ir.getChannelData(c); for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.6); }
          verb.buffer = ir; wet.gain.value = 0.45;
          verb.connect(wet).connect(warm);
          const echo = audio.createDelay(2), feedback = audio.createGain();
          echo.delayTime.value = beat * 3; feedback.gain.value = 0.28;
          echo.connect(feedback).connect(echo); echo.connect(verb); echo.connect(warm);
          // One soft voice: an oscillator with a slow rise and fall, sent dry and to the reverb.
          const note = (type, freq, at, peak, attack, length, detune = 0, send = 0.6) => {
            const o = audio.createOscillator(), g = audio.createGain(), s = audio.createGain();
            o.type = type; o.frequency.setValueAtTime(freq, at); o.detune.value = detune;
            g.gain.setValueAtTime(0.0001, at);
            g.gain.exponentialRampToValueAtTime(peak, at + attack);
            g.gain.setValueAtTime(peak, at + Math.max(attack, length - attack * 1.5));
            g.gain.exponentialRampToValueAtTime(0.0001, at + length);
            s.gain.value = send;
            o.connect(g); g.connect(warm); g.connect(s).connect(verb);
            o.start(at); o.stop(at + length + 0.05);
            return g;
          };
          // Pads: each chord note as a sine and a barely detuned triangle through a soft filter, swelling in slowly and lasting a chord and a half.
          const pad = (freq, at, length) => {
            const f = audio.createBiquadFilter();
            f.type = 'lowpass'; f.frequency.setValueAtTime(600, at); f.frequency.linearRampToValueAtTime(950, at + length / 2); f.frequency.linearRampToValueAtTime(600, at + length);
            f.connect(warm);
            [['sine', 0], ['triangle', 3]].forEach(([type, d]) => {
              const o = audio.createOscillator(), g = audio.createGain(), s = audio.createGain();
              o.type = type; o.frequency.value = freq; o.detune.value = d;
              g.gain.setValueAtTime(0.0001, at);
              g.gain.exponentialRampToValueAtTime(0.018, at + 2.6);
              g.gain.setValueAtTime(0.018, at + length - 2.6);
              g.gain.exponentialRampToValueAtTime(0.0001, at + length);
              s.gain.value = 0.9;
              o.connect(g); g.connect(f); g.connect(s).connect(verb);
              o.start(at); o.stop(at + length + 0.05);
            });
          };
          // Carry on from the same place in the tune: the saved step plus however many beats the page change took.
          // The whole pattern is 32 steps long: four chords of eight steps.
          let step = saved ? (saved.step + Math.round((Date.now() - saved.t) / 1000 / beat)) % 32 : 0, when = audio.currentTime + 0.1;
          const schedule = () => {
            while (when < audio.currentTime + 0.6) {
              const chord = chords[Math.floor(step / 8) % chords.length], s8 = step % 8, at = when;
              if (s8 === 0) {
                chord.keys.forEach((f) => pad(f, at, beat * 12));
                note('sine', chord.bass * 2, at, 0.07, 1.5, beat * 9, 0, 0.3);
              }
              const top = melody[step % 32];
              if (top) note('sine', top, at, 0.02, 0.08, beat * 4, 0, 0.8).connect(echo);
              step += 1; when += beat;
            }
          };
          schedule();
          music = { out, timer: setInterval(schedule, 100) };
          // Remember the position when the page is left. A step that is scheduled but not yet heard is counted back out.
          addEventListener('pagehide', () => {
            const ahead = Math.max(0, Math.round((when - audio.currentTime) / beat));
            try { sessionStorage.setItem('music-at', JSON.stringify({ step: (step - ahead + 320) % 32, t: Date.now() })); } catch (e) {}
          });
        };
        addEventListener('pointerdown', (e) => {
          tick(e.target.closest && e.target.closest('a, button, summary') ? 880 : 420);
          startMusic();
        }, { passive: true });
        addEventListener('keydown', startMusic, { once: true });
        // Set the music up straight away. If the browser blocks sound until an interaction, it waits silently and the
        // first click, tap or key press (which calls ctx() and resumes the audio) lets it play.
        startMusic();
        addEventListener('touchend', () => ctx(), { passive: true, once: true });
        // Silence when the tab is in the background.
        document.addEventListener('visibilitychange', () => { if (audio) document.hidden ? audio.suspend() : audio.resume(); });

        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js');
        const count = (el) => {
          const end = +el.dataset.count, dec = +(el.dataset.dec || 0), t0 = performance.now();
          const step = (t) => {
            const k = Math.min((t - t0) / 1100, 1);
            el.textContent = (end * (1 - Math.pow(1 - k, 3))).toFixed(dec);
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        // Section headings type themselves out once. The height is reserved first so nothing below moves,
        // and the full text stays available to screen readers through aria-label.
        const type = (el) => {
          const text = el.textContent;
          el.style.minHeight = el.offsetHeight + 'px';
          el.setAttribute('aria-label', text);
          el.textContent = '';
          el.classList.add('typing');
          let i = 0;
          const next = () => {
            el.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(next, 26);
            else setTimeout(() => el.classList.remove('typing'), 1400);
          };
          next();
        };
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (e.target.dataset.count) count(e.target);
          if (e.target.tagName === 'H2') type(e.target);
          io.unobserve(e.target);
        }), { threshold: 0.15 });
        // Only section headings type themselves; headings inside articles, tiles and cards stay still.
        document.querySelectorAll('[data-reveal], [data-count], main h2').forEach((el) => { if (!el.closest('.article, .tile, .post-feature, .connect')) io.observe(el); });

        // Dot fields: each canvas draws a grid of dots with a slow wave through it. Dots near the pointer turn the
        // accent colour, grow and lean away. A field only draws while it is on screen, and fades out towards its edges.
        const fields = [...document.querySelectorAll('.dots')].map((cv) => {
          const g = cv.getContext('2d'), gap = 28, f = { cv, mx: -999, my: -999 };
          let w = 0, h = 0, on = false;
          const size = () => {
            const d = Math.min(devicePixelRatio || 1, 2);
            w = cv.clientWidth; h = cv.clientHeight;
            cv.width = w * d; cv.height = h * d;
            g.setTransform(d, 0, 0, d, 0, 0);
          };
          const draw = (t) => {
            g.clearRect(0, 0, w, h);
            for (let y = gap / 2; y < h; y += gap) {
              const edge = Math.max(0, Math.min(1, y / 90, (h - y) / 150));
              for (let x = gap / 2; x < w; x += gap) {
                const dx = x - f.mx, dy = y - f.my, near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 200);
                if (near > 0.02) {
                  const a = Math.atan2(dy, dx), push = near * near * 16;
                  g.fillStyle = 'rgba(167,139,250,' + (0.25 + near * 0.75) * edge + ')';
                  g.beginPath(); g.arc(x + Math.cos(a) * push, y + Math.sin(a) * push, 1 + near * 2, 0, 6.2832); g.fill();
                } else {
                  g.fillStyle = 'rgba(239,234,246,' + (0.04 + 0.09 * (0.5 + 0.5 * Math.sin(x * 0.011 + y * 0.017 - t * 0.0011))) * edge + ')';
                  g.fillRect(x - 1, y - 1, 2, 2);
                }
              }
            }
            if (on) requestAnimationFrame(draw);
          };
          size(); addEventListener('resize', size);
          new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) requestAnimationFrame(draw); }).observe(cv);
          return f;
        });

        if (matchMedia('(hover: hover)').matches) {
          addEventListener('pointermove', (e) => {
            fields.forEach((f) => { const r = f.cv.getBoundingClientRect(); f.mx = e.clientX - r.left; f.my = e.clientY - r.top; });
          }, { passive: true });
          document.querySelectorAll('[data-tilt]').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect(), px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
              el.style.transform = 'perspective(900px) rotateY(' + px * 14 + 'deg) rotateX(' + -py * 14 + 'deg) scale(1.03)';
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
        }
      })();
    </script>
  </body>
</html>
