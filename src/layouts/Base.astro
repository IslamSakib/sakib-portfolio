---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import fontUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import { site } from '../site.js';
import { socials } from '../socials.js';

const { title, description, jsonld = [], ogImage = '/og.png', focus } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-focus={focus}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#191817" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="author" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="word">Sakib <b>Islam</b><i aria-hidden="true">.</i></span>
        </a>
        <nav aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/#services">Services</a>
          <a href="/#audit">Free audit</a>
          <a href="/#reviews">Reviews</a>
          <a href="/#faq">FAQ</a>
          <button class="btn btn-small" type="button" data-chat-open>Start a project</button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span class="bigmark" aria-hidden="true">Sakib Islam<i>.</i></span>
      <div class="wrap foot">
        <p>
          {site.name}, {site.role} in {site.location}. Founder of{' '}<a href={site.wrkbase} target="_blank" rel="noopener">Wrkbase</a>.
        </p>
        <p class="foot-links">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><svg class="ico" viewBox={`0 0 ${s.box} ${s.box}`} width="18" height="18" aria-hidden="true"><path d={s.path} /></svg></a>
          ))}
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" data-top aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="chat" data-chat data-whatsapp={site.whatsapp}>
      <div class="chat-panel" role="dialog" aria-label="Project chat with Sakib's assistant" hidden>
        <header>
          <div>
            <strong>Sakib's assistant</strong>
            <span>Automated. Your answers go straight to Sakib.</span>
          </div>
          <button class="chat-close" type="button" aria-label="Close chat">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </header>
        <div class="chat-log" aria-live="polite"></div>
        <div class="chat-chips"></div>
        <form autocomplete="off">
          <input class="chat-trap" type="text" name="company" tabindex="-1" aria-hidden="true" />
          <label class="chat-sr" for="chat-msg">Your message</label>
          <input id="chat-msg" type="text" name="msg" placeholder="Type your answer" maxlength="600" enterkeyhint="send" />
          <button type="submit" aria-label="Send">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </form>
      </div>
      <button class="chat-launcher" type="button" aria-expanded="false" aria-label="Open project chat">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
      </button>
    </div>
    <script>
      import '../scripts/chat.js';
    </script>
    <script is:inline>
      // All motion that needs script: scroll reveals, number tickers, typed headings, the cursor glow and spotlight,
      // magnetic buttons, the tilting portrait, the hero dot field and the Dhaka clock. Skipped under reduced motion.
      (() => {
        const clocks = document.querySelectorAll('[data-clock]');
        if (clocks.length) {
          const show = () => {
            const now = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dhaka' }).format(new Date()) + ' local';
            clocks.forEach((c) => { c.textContent = now; });
          };
          show(); setInterval(show, 30000);
        }
        // Sound: a soft tick on every click and a continuous, quiet generated music bed, both made with Web Audio (no audio files).
        // Browsers only allow sound after the visitor's first click or key press, so the music starts then. There is no off switch, by request.
        let audio, music = null;
        const ctx = () => {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          audio = audio || new AC();
          if (audio.state === 'suspended') audio.resume();
          return audio;
        };
        const tick = (freq) => {
          if (!ctx()) return;
          const o = audio.createOscillator(), g = audio.createGain(), t = audio.currentTime;
          o.type = 'sine';
          o.frequency.setValueAtTime(freq, t);
          o.frequency.exponentialRampToValueAtTime(freq * 0.55, t + 0.09);
          g.gain.setValueAtTime(0.0001, t);
          g.gain.exponentialRampToValueAtTime(0.06, t + 0.008);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 0.11);
          o.connect(g).connect(audio.destination);
          o.start(t); o.stop(t + 0.12);
        };
        // Music: a slow, warm groove to match the dark page. Four seventh chords (A minor 7, F major 7, C major 7, E minor 7)
        // at 84 beats a minute: a filtered pad that slowly opens and closes, a deep bass, a few bell notes with an echo,
        // and a soft swung beat. Notes are scheduled ahead on the audio clock, so it never drops out, and it carries on
        // from page to page once the visitor has clicked anywhere.
        const chords = [[220.0, 261.63, 329.63, 392.0], [174.61, 220.0, 261.63, 329.63], [130.81, 164.81, 196.0, 246.94], [164.81, 196.0, 246.94, 293.66]];
        const bells = [3, -1, 2, -1, -1, 1, -1, 2, -1, 3, -1, -1, 0, -1, 2, -1];
        const startMusic = () => {
          if (music || !ctx()) return;
          try { sessionStorage.setItem('music', 'on'); } catch (e) {}
          const out = audio.createGain(), pad = audio.createBiquadFilter(), lfo = audio.createOscillator(), depth = audio.createGain();
          const echo = audio.createDelay(1), feedback = audio.createGain(), echoTone = audio.createBiquadFilter();
          out.gain.setValueAtTime(0.0001, audio.currentTime);
          out.gain.exponentialRampToValueAtTime(0.85, audio.currentTime + 2);
          out.connect(audio.destination);
          // the pad's brightness drifts up and down over about twenty seconds
          pad.type = 'lowpass'; pad.frequency.value = 620; pad.Q.value = 0.8;
          lfo.frequency.value = 0.05; depth.gain.value = 260;
          lfo.connect(depth).connect(pad.frequency); lfo.start();
          pad.connect(out);
          const beat = 60 / 84 / 2;
          echo.delayTime.value = beat * 1.5; feedback.gain.value = 0.38;
          echoTone.type = 'lowpass'; echoTone.frequency.value = 1800;
          echo.connect(echoTone).connect(feedback).connect(echo);
          echoTone.connect(out);
          const noise = audio.createBuffer(1, audio.sampleRate * 0.12, audio.sampleRate);
          const nd = noise.getChannelData(0);
          for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1;
          const note = (type, freq, at, peak, attack, length, dest, detune) => {
            const o = audio.createOscillator(), g = audio.createGain();
            o.type = type; o.frequency.setValueAtTime(freq, at); o.detune.value = detune || 0;
            g.gain.setValueAtTime(0.0001, at);
            g.gain.exponentialRampToValueAtTime(peak, at + attack);
            g.gain.exponentialRampToValueAtTime(0.0001, at + length);
            o.connect(g).connect(dest);
            o.start(at); o.stop(at + length + 0.05);
            return [o, g];
          };
          let step = 0, when = audio.currentTime + 0.1;
          const schedule = () => {
            while (when < audio.currentTime + 0.5) {
              const bar = Math.floor(step / 8), chord = chords[bar % chords.length], s8 = step % 8;
              const swing = s8 % 2 === 1 ? beat * 0.16 : 0, at = when + swing;
              // pad: the whole chord for a bar, each bar overlapping the next
              if (s8 === 0) chord.forEach((f) => { note('sawtooth', f, when, 0.022, 0.9, beat * 8 + 1.4, pad, -6); note('sawtooth', f, when, 0.022, 0.9, beat * 8 + 1.4, pad, 6); });
              // bass: root on one, a push before three, an octave down
              if (s8 === 0 || s8 === 3 || s8 === 6) note('sine', chord[0] / 2, at, s8 === 0 ? 0.2 : 0.13, 0.015, beat * (s8 === 0 ? 2.6 : 1.4), out);
              // bells: a sparse line with an echo
              const bell = bells[step % bells.length];
              if (bell >= 0) {
                const [, g] = note('sine', chord[bell] * 2, at, 0.05, 0.006, 0.9, out);
                g.connect(echo);
              }
              // beat: soft kick on one and the push, a quiet rim on two and four, brushed noise on the off-beats
              if (s8 === 0 || s8 === 5) note('sine', 120, at, 0.22, 0.004, 0.2, out)[0].frequency.exponentialRampToValueAtTime(42, at + 0.16);
              if (s8 === 2 || s8 === 6) note('triangle', 880, at, 0.035, 0.002, 0.06, out);
              if (s8 % 2 === 1) {
                const n = audio.createBufferSource(), g = audio.createGain(), hp = audio.createBiquadFilter();
                n.buffer = noise; hp.type = 'highpass'; hp.frequency.value = 7000;
                g.gain.setValueAtTime(0.014, at); g.gain.exponentialRampToValueAtTime(0.0001, at + 0.07);
                n.connect(hp).connect(g).connect(out); n.start(at); n.stop(at + 0.1);
              }
              step += 1; when += beat;
            }
          };
          schedule();
          music = { out, timer: setInterval(schedule, 100) };
        };
        addEventListener('pointerdown', (e) => {
          tick(e.target.closest && e.target.closest('a, button, summary') ? 880 : 420);
          startMusic();
        }, { passive: true });
        addEventListener('keydown', startMusic, { once: true });
        try { if (sessionStorage.getItem('music') === 'on') startMusic(); } catch (e) {}
        // Silence when the tab is in the background.
        document.addEventListener('visibilitychange', () => { if (audio) document.hidden ? audio.suspend() : audio.resume(); });

        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js');
        const count = (el) => {
          const end = +el.dataset.count, dec = +(el.dataset.dec || 0), t0 = performance.now();
          const step = (t) => {
            const k = Math.min((t - t0) / 1100, 1);
            el.textContent = (end * (1 - Math.pow(1 - k, 3))).toFixed(dec);
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        // Section headings type themselves out. The height is reserved first so nothing below moves.
        const type = (el) => {
          const text = el.textContent.trim(), gap = Math.min(32, 1100 / text.length);
          el.style.minHeight = el.offsetHeight + 'px';
          el.setAttribute('aria-label', text);
          el.textContent = '';
          el.classList.add('typing');
          let i = 0;
          const next = () => {
            el.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(next, gap);
            else setTimeout(() => el.classList.remove('typing'), 1400);
          };
          next();
        };
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (e.target.dataset.count) count(e.target);
          if (e.target.tagName === 'H2') type(e.target);
          io.unobserve(e.target);
        }), { threshold: 0.15 });
        document.querySelectorAll('[data-reveal], [data-count], main h2').forEach((el) => io.observe(el));

        // Dot fields (hero and contact): a slow wave runs through each, and dots near the cursor light up and move away from it.
        // Each canvas only draws while it is on screen.
        const fields = [...document.querySelectorAll('.dots')].map((cv) => {
          const ctx = cv.getContext('2d'), gap = 26, f = { cv, mx: -999, my: -999 };
          let w = 0, h = 0, on = false;
          const size = () => {
            const d = Math.min(devicePixelRatio || 1, 2);
            w = cv.clientWidth; h = cv.clientHeight;
            cv.width = w * d; cv.height = h * d;
            ctx.setTransform(d, 0, 0, d, 0, 0);
          };
          const draw = (t) => {
            ctx.clearRect(0, 0, w, h);
            for (let y = gap / 2; y < h; y += gap) for (let x = gap / 2; x < w; x += gap) {
              const dx = x - f.mx, dy = y - f.my, near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 190);
              if (near > 0.02) {
                const a = Math.atan2(dy, dx), push = near * near * 14;
                ctx.fillStyle = 'rgba(255,133,82,' + (0.2 + near * 0.8) + ')';
                ctx.beginPath(); ctx.arc(x + Math.cos(a) * push, y + Math.sin(a) * push, 1 + near * 1.8, 0, 6.2832); ctx.fill();
              } else {
                ctx.fillStyle = 'rgba(245,244,239,' + (0.05 + 0.1 * (0.5 + 0.5 * Math.sin(x * 0.011 + y * 0.017 - t * 0.0011))) + ')';
                ctx.fillRect(x - 1, y - 1, 2, 2);
              }
            }
            if (on) requestAnimationFrame(draw);
          };
          size(); addEventListener('resize', size);
          new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) requestAnimationFrame(draw); }).observe(cv);
          return f;
        });

        if (matchMedia('(hover: hover)').matches) {
          // The normal cursor stays. A soft glow trails it with a little lag, and the dot fields react to it.
          const root = document.documentElement;
          let px = -999, py = -999, gx = -999, gy = -999, running = false;
          const follow = () => {
            gx += (px - gx) * 0.12; gy += (py - gy) * 0.12;
            root.style.setProperty('--gx', gx + 'px');
            root.style.setProperty('--gy', gy + 'px');
            if (Math.abs(px - gx) + Math.abs(py - gy) > 0.3) requestAnimationFrame(follow); else running = false;
          };
          addEventListener('pointermove', (e) => {
            if (px === -999) { gx = e.clientX; gy = e.clientY; }
            px = e.clientX; py = e.clientY;
            if (!running) { running = true; requestAnimationFrame(follow); }
            fields.forEach((f) => { const r = f.cv.getBoundingClientRect(); f.mx = px - r.left; f.my = py - r.top; });
          }, { passive: true });
          document.querySelectorAll('[data-spot]').forEach((el) => el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', e.clientX - r.left + 'px');
            el.style.setProperty('--my', e.clientY - r.top + 'px');
          }));
          document.querySelectorAll('[data-magnet]').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.transform = 'translate(' + (e.clientX - r.left - r.width / 2) * 0.28 + 'px,' + (e.clientY - r.top - r.height / 2) * 0.4 + 'px)';
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
          document.querySelectorAll('[data-tilt]').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect(), px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
              el.style.transform = 'perspective(900px) rotateY(' + px * 14 + 'deg) rotateX(' + -py * 14 + 'deg) scale(1.03)';
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
        }
      })();
    </script>
  </body>
</html>
