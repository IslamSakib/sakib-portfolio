# Served from Hostinger (Apache/LiteSpeed). HTTPS only, the site's own 404 page, long caching for fingerprinted files.
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Astro puts a content hash in every file name under /_astro/, so they can be cached for a year
  <FilesMatch "\.(avif|webp|png|jpg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

# Upload packages and the host's placeholder page are not part of the site
<FilesMatch "(\.zip|^default\.php|^d-[a-z0-9]+\.php|^lead-config\.php)$">
  Require all denied
</FilesMatch>
