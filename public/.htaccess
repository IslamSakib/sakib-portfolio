# Served from Hostinger (Apache/LiteSpeed). HTTPS only, the site's own 404 page, long caching for fingerprinted files.
# Pages are revalidated on every visit (no-cache), so a new deploy shows at once; hashed assets cache for a year.
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Pages merged in the October 2026 rebuild
  RewriteRule ^ai-development/?$ /web-application-development/ai-integration/ [L,R=301]
  # Services moved under the three pillars (23 Oct 2026): custom website, web application, WordPress
  RewriteRule ^website-care/?$ /custom-web-development/website-maintenance/ [L,R=301]
  RewriteRule ^wordpress-maintenance/?$ /wordpress-development/wordpress-maintenance/ [L,R=301]
  RewriteRule ^wordpress-speed-optimization/?$ /wordpress-development/wordpress-speed-optimization/ [L,R=301]
  RewriteRule ^wordpress-care-plans/?$ /wordpress-development/wordpress-maintenance/ [L,R=301]
  RewriteRule ^wordpress-repair/?$ /wordpress-development/wordpress-repair/ [L,R=301]
  RewriteRule ^wordpress-malware-removal/?$ /wordpress-development/wordpress-malware-removal/ [L,R=301]
  RewriteRule ^white-label-wordpress-development/?$ /wordpress-development/white-label-wordpress-development/ [L,R=301]
  RewriteRule ^white-label-wordpress-maintenance/?$ /wordpress-development/white-label-wordpress-maintenance/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Only this site's own files may load. Inline scripts and styles are allowed because Astro inlines small ones.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Astro puts a content hash in every file name under /_astro/, so they can be cached for a year
  <FilesMatch "\.(avif|webp|png|jpg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Hidden files (.git, .env and the like) and stray Markdown are never served
<FilesMatch "^\.(?!htaccess$)|\.md$">
  Require all denied
</FilesMatch>

# Upload packages and the host's placeholder page are not part of the site
<FilesMatch "(\.zip|^default\.php|^d-[a-z0-9]+\.php|^lead-config\.php)$">
  Require all denied
</FilesMatch>
